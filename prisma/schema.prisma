generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  customers        Customer[]
  karigars         Karigar[]
  products         Product[]
  inventoryStock   InventoryStock[]
  invoices         Invoice[]
  kachaInvoices    KachaInvoice[]
  ledgerEntries    LedgerEntry[]
  karigarJobs      KarigarJob[]
  metalRates       MetalRate[]
  businessSettings BusinessSettings?
  inviteTokens     InviteToken[]
  vendors          Vendor[]
  purchases        Purchase[]
  purityFinenesses PurityFineness[]
  quotations       Quotation[]
  storeMetals      StoreMetal[]
  storeCategories  StoreCategory[]
  storeLocations   StoreLocation[]

  @@index([code])
}

model StoreLocation {
  id              String               @id @default(cuid())
  storeId         String
  name            String
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  store           Store                @relation(fields: [storeId], references: [id])
  inventoryStocks InventoryStock[]
  karigars        Karigar[]
  purchases       Purchase[]
  invoices        Invoice[]
  kachaInvoices   KachaInvoice[]
  karigarJobs     KarigarJob[]
  ledgerEntries   LedgerEntry[]
  userAccess      UserLocationAccess[]

  @@unique([storeId, name])
}

/**
 * Grants a Staff user access to one or more locations. Mirrors the
 * User.permissions convention: zero rows for a user means unrestricted
 * (sees every location), same as an empty `permissions` array meaning
 * "not customized" falls back to full module access — the two axes are
 * independent (a module permission and a location grant), but both use
 * the same "empty = unrestricted" rule so they don't have to be reasoned
 * about differently. Only Staff is ever actually restricted — Admin/Super
 * Admin/Karigar are never gated by this table (Karigar's own scoping goes
 * through Karigar.locationId instead, since a User with role KARIGAR is
 * always 1:1 with a Karigar row via User.karigarId).
 */
model UserLocationAccess {
  id         String        @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id])
  location   StoreLocation @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
}

model StoreMetal {
  id                  String               @id @default(cuid())
  storeId             String
  name                String
  hasPurity           Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  store               Store                @relation(fields: [storeId], references: [id])
  products            Product[]
  inventoryStocks     InventoryStock[]
  kachaInvoiceItems   KachaInvoiceItem[]
  invoiceItems        InvoiceItem[]
  ledgerEntries       LedgerEntry[]
  karigarJobs         KarigarJob[]
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  quotationItems      QuotationItem[]

  @@unique([storeId, name])
}

model StoreCategory {
  id        String              @id @default(cuid())
  storeId   String
  name      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  store     Store               @relation(fields: [storeId], references: [id])
  types     StoreCategoryType[]
  products  Product[]

  @@unique([storeId, name])
}

model StoreCategoryType {
  id         String        @id @default(cuid())
  storeId    String
  categoryId String
  name       String
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
}

model Customer {
  id             String         @id @default(cuid())
  storeId        String
  customerCode   String?
  name           String
  phone          String?
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?
  notes          String?
  openingBalance Decimal        @default(0) @db.Decimal(12, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isArchived     Boolean        @default(false)
  store          Store          @relation(fields: [storeId], references: [id])
  invoices       Invoice[]
  kachaInvoices  KachaInvoice[]
  ledgerEntries  LedgerEntry[]
  quotations     Quotation[]

  @@unique([storeId, customerCode])
  @@unique([storeId, phone])
  @@index([name])
  @@index([phone])
  @@index([customerCode])
  @@index([storeId])
}

model Karigar {
  id             String        @id @default(cuid())
  storeId        String
  code           String?
  name           String
  mobile         String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  pincode        String?
  gstNumber      String?
  panNumber      String?
  aadhaarNumber  String?
  specialization String?
  notes          String?
  openingGold    Decimal       @default(0) @db.Decimal(10, 3)
  openingCash    Decimal       @default(0) @db.Decimal(12, 2)
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  store          Store         @relation(fields: [storeId], references: [id])
  karigarJobs    KarigarJob[]
  ledgerEntries  LedgerEntry[]
  loginUser      User?
  locationId     String?
  location       StoreLocation? @relation(fields: [locationId], references: [id])

  @@unique([storeId, code])
  @@index([name])
  @@index([mobile])
  @@index([code])
  @@index([locationId])
  @@index([storeId])
}

model Product {
  id                  String               @id @default(cuid())
  storeId             String
  productCode         String
  name                String
  categoryId          String?
  categoryTypeId      String?
  metalTypeId         String?
  defaultPurity       PurityType?
  defaultMakingCharge Decimal?             @db.Decimal(12, 2)
  defaultMakingChargeType ChargeType       @default(FIXED)
  defaultStoneCharge  Decimal?             @db.Decimal(12, 2)
  defaultStoneChargeType  ChargeType       @default(FIXED)
  designCode          String?
  hsnCode             String?
  description         String?
  notes               String?
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  store               Store                @relation(fields: [storeId], references: [id])
  stockItems          InventoryStock[]
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  category            StoreCategory?       @relation(fields: [categoryId], references: [id])
  categoryType        StoreCategoryType?   @relation(fields: [categoryTypeId], references: [id])
  metalType           StoreMetal?          @relation(fields: [metalTypeId], references: [id])

  @@unique([storeId, productCode])
  @@index([categoryId])
  @@index([categoryTypeId])
  @@index([metalTypeId])
  @@index([name])
  @@index([productCode])
  @@index([designCode])
  @@index([storeId])
}

model InventoryStock {
  id                  String                 @id @default(cuid())
  storeId             String
  stockCode           String
  tagNumber           String?
  productId           String
  metalTypeId         String?
  purity              PurityType?
  quantity            Int                    @default(1)
  status              InventoryStockStatus   @default(IN_STOCK)
  finish              InventoryFinish        @default(KACHA)
  isActive            Boolean                @default(true)
  grossWeight         Decimal?               @db.Decimal(10, 3)
  lessWeight          Decimal?               @db.Decimal(10, 3)
  netWeight           Decimal?               @db.Decimal(10, 3)
  stoneWeight         Decimal?               @db.Decimal(10, 3)
  dmoWeight           Decimal?               @db.Decimal(10, 3)
  wastagePercent      Decimal?               @db.Decimal(5, 2)
  purchaseRate        Decimal?               @db.Decimal(12, 2)
  saleRate            Decimal?               @db.Decimal(12, 2)
  makingCharge        Decimal?               @db.Decimal(12, 2)
  makingChargeType    ChargeType             @default(FIXED)
  stoneCharge         Decimal?               @db.Decimal(12, 2)
  otherCharge         Decimal?               @db.Decimal(12, 2)
  purchaseAmount      Decimal?               @db.Decimal(12, 2)
  saleAmount          Decimal?               @db.Decimal(12, 2)
  vendorName          String?
  purchaseDate        DateTime?
  manufactureDate     DateTime?
  locationId          String?
  remarks             String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  store               Store                  @relation(fields: [storeId], references: [id])
  product             Product                @relation(fields: [productId], references: [id])
  transactions        InventoryTransaction[]
  invoiceItems        InvoiceItem[]
  kachaInvoiceItems   KachaInvoiceItem[]
  karigarJobs         KarigarJob[]
  vendor              Vendor?                @relation(fields: [vendorId], references: [id])
  vendorId            String?
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  quotationItems      QuotationItem[]
  metalType           StoreMetal?            @relation(fields: [metalTypeId], references: [id])
  location            StoreLocation?         @relation(fields: [locationId], references: [id])

  @@unique([storeId, stockCode])
  @@unique([storeId, tagNumber])
  @@index([stockCode])
  @@index([tagNumber])
  @@index([productId])
  @@index([metalTypeId])
  @@index([purity])
  @@index([status])
  @@index([finish])
  @@index([purchaseDate])
  @@index([locationId])
  @@index([vendorId])
  @@index([storeId])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  inventoryStockId String
  transactionType  InventoryTransactionType
  quantity         Int                      @default(1)
  grossWeight      Decimal?                 @db.Decimal(10, 3)
  netWeight        Decimal?                 @db.Decimal(10, 3)
  referenceType    String?
  referenceId      String?
  notes            String?
  createdAt        DateTime                 @default(now())
  inventoryStock   InventoryStock           @relation(fields: [inventoryStockId], references: [id], onDelete: Cascade)

  @@index([inventoryStockId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Invoice {
  id                     String        @id @default(cuid())
  storeId                String
  invoiceNumber          String
  customerId             String
  invoiceDate            DateTime      @default(now())
  dueDate                DateTime?
  status                 InvoiceStatus @default(PAID)
  subtotal               Decimal       @default(0) @db.Decimal(12, 2)
  makingCharges          Decimal       @default(0) @db.Decimal(12, 2)
  stoneCharges           Decimal       @default(0) @db.Decimal(12, 2)
  discount               Decimal       @default(0) @db.Decimal(12, 2)
  taxAmount              Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal       @default(0) @db.Decimal(12, 2)
  paidAmount             Decimal       @default(0) @db.Decimal(12, 2)
  balanceAmount          Decimal       @default(0) @db.Decimal(12, 2)
  notes                  String?
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  store                  Store         @relation(fields: [storeId], references: [id])
  customer               Customer      @relation(fields: [customerId], references: [id])
  items                  InvoiceItem[]
  ledgerEntries          LedgerEntry[]
  convertedFromKacha     KachaInvoice? @relation("KachaConvertedToPakka")
  convertedFromQuotation Quotation?    @relation("QuotationConvertedToInvoice")
  locationId             String?
  location               StoreLocation? @relation(fields: [locationId], references: [id])

  @@unique([storeId, invoiceNumber])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([invoiceNumber])
  @@index([storeId])
  @@index([locationId])
}

model KachaInvoice {
  id            String             @id @default(cuid())
  storeId       String
  slipNumber    String
  customerId    String
  invoiceDate   DateTime           @default(now())
  status        InvoiceStatus      @default(PAID)
  subtotal      Decimal            @default(0) @db.Decimal(12, 2)
  makingCharges Decimal            @default(0) @db.Decimal(12, 2)
  stoneCharges  Decimal            @default(0) @db.Decimal(12, 2)
  discount      Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal            @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal            @default(0) @db.Decimal(12, 2)
  notes         String?
  convertedToId String?            @unique
  convertedTo   Invoice?           @relation("KachaConvertedToPakka", fields: [convertedToId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  store         Store              @relation(fields: [storeId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  items         KachaInvoiceItem[]
  locationId    String?
  location      StoreLocation?     @relation(fields: [locationId], references: [id])

  @@unique([storeId, slipNumber])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([slipNumber])
  @@index([storeId])
  @@index([locationId])
}

model KachaInvoiceItem {
  id               String          @id @default(cuid())
  kachaInvoiceId   String
  itemName         String
  metalTypeId      String?
  purity           PurityType?
  quantity         Int             @default(1)
  grossWeight      Decimal?        @db.Decimal(10, 3)
  netWeight        Decimal?        @db.Decimal(10, 3)
  dmoWeight        Decimal?        @db.Decimal(10, 3)
  rate             Decimal?        @db.Decimal(12, 2)
  makingCharge     Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType ChargeType      @default(FIXED)
  stoneCharge      Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  kachaInvoice     KachaInvoice    @relation(fields: [kachaInvoiceId], references: [id], onDelete: Cascade)
  metalType        StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([kachaInvoiceId])
  @@index([inventoryStockId])
}

model InvoiceItem {
  id               String          @id @default(cuid())
  invoiceId        String
  itemName         String
  metalTypeId      String?
  quantity         Int             @default(1)
  grossWeight      Decimal?        @db.Decimal(10, 3)
  netWeight        Decimal?        @db.Decimal(10, 3)
  dmoWeight        Decimal?        @db.Decimal(10, 3)
  rate             Decimal?        @db.Decimal(12, 2)
  makingCharge     Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType ChargeType      @default(FIXED)
  stoneCharge      Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal         @default(0) @db.Decimal(12, 2)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  inventoryStockId String?
  purity           PurityType?
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  invoice          Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  metalType        StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([invoiceId])
  @@index([inventoryStockId])
}

model LedgerEntry {
  id               String           @id @default(cuid())
  storeId          String
  entryDate        DateTime         @default(now())
  type             LedgerEntryType
  sourceType       LedgerSourceType @default(MANUAL)
  customerId       String?
  karigarId        String?
  invoiceId        String?
  purchaseId       String?
  vendorId         String?
  metalTypeId      String?
  metalWeight      Decimal?         @db.Decimal(10, 3)
  metalWeightFine  Decimal?         @db.Decimal(10, 3)
  amount           Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?
  paymentReference String?
  bankName         String?
  attachmentUrl    String?
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  store            Store            @relation(fields: [storeId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  karigar          Karigar?         @relation(fields: [karigarId], references: [id])
  purchase         Purchase?        @relation(fields: [purchaseId], references: [id])
  vendor           Vendor?          @relation(fields: [vendorId], references: [id])
  metalType        StoreMetal?      @relation(fields: [metalTypeId], references: [id])
  locationId       String?
  location         StoreLocation?   @relation(fields: [locationId], references: [id])

  @@index([entryDate])
  @@index([customerId])
  @@index([karigarId])
  @@index([invoiceId])
  @@index([purchaseId])
  @@index([vendorId])
  @@index([type])
  @@index([sourceType])
  @@index([storeId])
  @@index([locationId])
}

model KarigarJob {
  id                String               @id @default(cuid())
  storeId           String
  jobNumber         String?
  karigarId         String
  issueDate         DateTime             @default(now())
  expectedDate      DateTime?
  receivedDate      DateTime?
  metalTypeId       String?
  issueWeight       Decimal?             @db.Decimal(10, 3)
  issuePurity       PurityType?
  issueFineWeight   Decimal?             @db.Decimal(10, 3)
  receiveWeight     Decimal?             @db.Decimal(10, 3)
  receiveFineWeight Decimal?             @db.Decimal(10, 3)
  labourCharge      Decimal              @default(0) @db.Decimal(12, 2)
  status            String               @default("issued")
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  inventoryStockId  String?
  store             Store                @relation(fields: [storeId], references: [id])
  inventoryStock    InventoryStock?      @relation(fields: [inventoryStockId], references: [id])
  karigar           Karigar              @relation(fields: [karigarId], references: [id])
  receiptItems      KarigarReceiptItem[]
  metalType         StoreMetal?          @relation(fields: [metalTypeId], references: [id])
  locationId        String?
  location          StoreLocation?       @relation(fields: [locationId], references: [id])

  @@unique([storeId, jobNumber])
  @@index([inventoryStockId])
  @@index([issueDate])
  @@index([jobNumber])
  @@index([karigarId])
  @@index([storeId])
  @@index([locationId])
}

model Vendor {
  id             String           @id @default(cuid())
  storeId        String
  vendorCode     String?
  name           String
  phone          String?
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?
  notes          String?
  openingBalance Decimal          @default(0) @db.Decimal(12, 2)
  isActive       Boolean          @default(true)
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  store          Store            @relation(fields: [storeId], references: [id])
  purchases      Purchase[]
  ledgerEntries  LedgerEntry[]
  inventoryStock InventoryStock[]

  @@unique([storeId, vendorCode])
  @@index([name])
  @@index([phone])
  @@index([storeId])
}

model Purchase {
  id             String         @id @default(cuid())
  storeId        String
  purchaseNumber String
  vendorId       String
  purchaseDate   DateTime       @default(now())
  status         InvoiceStatus  @default(PAID)
  subtotal       Decimal        @default(0) @db.Decimal(12, 2)
  makingCharges  Decimal        @default(0) @db.Decimal(12, 2)
  stoneCharges   Decimal        @default(0) @db.Decimal(12, 2)
  discount       Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal        @default(0) @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          Store          @relation(fields: [storeId], references: [id])
  vendor         Vendor         @relation(fields: [vendorId], references: [id])
  items          PurchaseItem[]
  ledgerEntries  LedgerEntry[]
  locationId     String?
  location       StoreLocation? @relation(fields: [locationId], references: [id])

  @@unique([storeId, purchaseNumber])
  @@index([vendorId])
  @@index([purchaseDate])
  @@index([status])
  @@index([storeId])
  @@index([locationId])
}

model PurchaseItem {
  id               String          @id @default(cuid())
  purchaseId       String
  productId        String
  itemName         String
  metalTypeId      String?
  purity           PurityType?
  quantity         Int             @default(1)
  grossWeight      Decimal?        @db.Decimal(10, 3)
  netWeight        Decimal?        @db.Decimal(10, 3)
  dmoWeight        Decimal?        @db.Decimal(10, 3)
  rate             Decimal?        @db.Decimal(12, 2)
  makingCharge     Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType ChargeType      @default(FIXED)
  stoneCharge      Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId String?
  createdAt        DateTime        @default(now())
  purchase         Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id])
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  metalType        StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([inventoryStockId])
}

model PurityFineness {
  id              String     @id @default(cuid())
  storeId         String
  purity          PurityType
  finenessPercent Decimal    @db.Decimal(5, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  store           Store      @relation(fields: [storeId], references: [id])

  @@unique([storeId, purity])
}

model KarigarReceiptItem {
  id               String          @id @default(cuid())
  karigarJobId     String
  itemName         String
  productId        String?
  metalTypeId      String?
  purity           PurityType
  quantity         Int             @default(1)
  grossWeight      Decimal?        @db.Decimal(10, 3)
  netWeight        Decimal?        @db.Decimal(10, 3)
  stoneWeight      Decimal?        @db.Decimal(10, 3)
  dmoWeight        Decimal?        @db.Decimal(10, 3)
  wastagePercent   Decimal?        @db.Decimal(5, 2)
  fineWeight       Decimal         @db.Decimal(10, 3)
  inventoryStockId String?
  createdAt        DateTime        @default(now())
  karigarJob       KarigarJob      @relation(fields: [karigarJobId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id])
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  metalType        StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([karigarJobId])
  @@index([productId])
  @@index([inventoryStockId])
}

model Quotation {
  id              String          @id @default(cuid())
  storeId         String
  quotationNumber String
  customerId      String
  quotationDate   DateTime        @default(now())
  validUntil      DateTime?
  status          String          @default("open")
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  makingCharges   Decimal         @default(0) @db.Decimal(12, 2)
  stoneCharges    Decimal         @default(0) @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  notes           String?
  convertedToId   String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  store           Store           @relation(fields: [storeId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  convertedTo     Invoice?        @relation("QuotationConvertedToInvoice", fields: [convertedToId], references: [id])
  items           QuotationItem[]

  @@unique([storeId, quotationNumber])
  @@index([customerId])
  @@index([quotationDate])
  @@index([storeId])
}

model QuotationItem {
  id               String          @id @default(cuid())
  quotationId      String
  itemName         String
  metalTypeId      String?
  purity           PurityType?
  quantity         Int             @default(1)
  grossWeight      Decimal?        @db.Decimal(10, 3)
  netWeight        Decimal?        @db.Decimal(10, 3)
  rate             Decimal?        @db.Decimal(12, 2)
  makingCharge     Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType ChargeType      @default(FIXED)
  stoneCharge      Decimal         @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId String?
  quotation        Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  metalType        StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([quotationId])
  @@index([inventoryStockId])
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  isoCode   String   @unique
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([name, stateId])
  @@index([stateId])
}

model MetalRate {
  id        String   @id @default(cuid())
  storeId   String
  gold22k   Decimal  @db.Decimal(12, 2)
  gold24k   Decimal  @db.Decimal(12, 2)
  gold18k   Decimal  @db.Decimal(12, 2)
  silver    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  unit      String   @default("GRAM")
  store     Store    @relation(fields: [storeId], references: [id])

  @@index([createdAt])
  @@index([storeId])
}

model BusinessSettings {
  storeId String @id
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Business identity
  businessName String
  legalName    String?
  logoUrl      String?

  // Tax / compliance
  gstNumber String?
  panNumber String?
  stateCode String? // GST state code, e.g. "27" for Maharashtra

  // Contact & address
  address String?
  city    String?
  state   String?
  pincode String?
  phone   String?
  email   String?
  website String?

  // Where destructive bulk operations send their backup before deleting
  // anything. Kept separate from `email` above (the store's public contact
  // address) so a backup can be routed to an owner/accountant inbox.
  backupEmail String?

  // Invoice preferences
  invoicePrefix     String  @default("INV")
  invoiceStartingNo Int     @default(1)
  invoiceTerms      String?
  invoiceNotes      String?

  // Tax defaults
  defaultGstRate Float @default(3.0) // jewellery GST is typically 3%

  // Financial year
  financialYearStartMonth Int @default(4) // April = 4, common in India

  // Which unit(s) this business transacts and settles balances in.
  // Drives how the ledger (general + per-customer) totals/entries are denominated.
  businessUnits BusinessUnit[] @default([MONEY])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model User {
  id                  String        @id @default(cuid())
  name                String?
  email               String?       @unique
  phone               String?       @unique
  image               String?
  role                UserRole      @default(STAFF)
  status              UserStatus    @default(INVITED)
  isActive            Boolean       @default(true)
  emailVerified       DateTime?
  phoneVerified       DateTime?
  invitedById         String?
  storeId             String?
  karigarId           String?       @unique
  permissions         String[]      @default([])
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  addressLine1        String?
  addressLine2        String?
  city                String?
  country             String?       @default("India")
  pincode             String?
  state               String?
  accounts            Account[]
  employee            Employee?
  store               Store?        @relation(fields: [storeId], references: [id])
  karigar             Karigar?      @relation(fields: [karigarId], references: [id])
  createdInviteTokens InviteToken[] @relation("UserCreatedInvites")
  inviteTokens        InviteToken[] @relation("InviteTokenUser")
  otpCodes            OtpCode[]
  sessions            Session[]
  invitedBy           User?         @relation("UserInvites", fields: [invitedById], references: [id])
  invitedUsers        User[]        @relation("UserInvites")
  locationAccess      UserLocationAccess[]

  @@index([storeId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InviteToken {
  id          String    @id @default(cuid())
  email       String?
  phone       String?
  tokenHash   String    @unique
  role        UserRole
  name        String?
  storeId     String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  userId      String?
  invitedById String
  createdAt   DateTime  @default(now())
  store       Store?    @relation(fields: [storeId], references: [id])
  invitedBy   User      @relation("UserCreatedInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  user        User?     @relation("InviteTokenUser", fields: [userId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([invitedById])
  @@index([storeId])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String?
  email      String?
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  userId     String?
  createdAt  DateTime   @default(now())
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([email, purpose])
  @@index([userId])
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  userId       String    @unique
  designation  String?
  branch       String?
  joiningDate  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LedgerEntryType {
  CREDIT
  DEBIT
}

enum PaymentMethod {
  CASH
  UPI
  NET_BANKING
  CHEQUE
  CARD
  OTHER
}

enum LedgerSourceType {
  MANUAL
  SALE
  PURCHASE
  KARIGAR_ISSUE
  KARIGAR_RECEIPT
  ADJUSTMENT
}

enum InvoiceStatus {
  DRAFT
  PAID
  PARTIAL
  CANCELLED
}

enum ChargeType {
  FIXED
  PERCENTAGE
}

enum BusinessUnit {
  MONEY
  GOLD
  SILVER
  DIAMOND
}

enum PurityType {
  GOLD_18K
  GOLD_20K
  GOLD_22K
  GOLD_24K
  SILVER_925
  SILVER_999
  OTHER
}

enum InventoryStockStatus {
  IN_STOCK
  SOLD
  RESERVED
  ISSUED_TO_KARIGAR
  DAMAGED
  ARCHIVED
}

enum InventoryFinish {
  KACHA
  PAKKA
}

enum InventoryTransactionType {
  OPENING
  PURCHASE
  SALE
  SALE_RETURN
  KARIGAR_ISSUE
  KARIGAR_RECEIPT
  ADJUSTMENT
  DAMAGE
  RESERVE
  UNRESERVE
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  STAFF
  KARIGAR
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum OtpPurpose {
  LOGIN
  PHONE_VERIFY
  PROFILE_PHONE_CHANGE
  PROFILE_EMAIL_CHANGE
}

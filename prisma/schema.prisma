generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planId             String?
  plan               Plan?     @relation(fields: [planId], references: [id])
  planStartedAt      DateTime?
  planExpiresAt      DateTime?
  planReminderSentAt DateTime?

  /**
   * When the owner was last told this store is archived. Every blocked
   * sign-in would otherwise send another email, so ten retries would mean
   * ten identical messages. Cleared on restore, so a store archived again
   * later notifies again.
   */
  archiveNotifiedAt DateTime?

  /**
   * Which channels this store's owner accepts renewal reminders on.
   * Email is wired up (app/api/cron/plan-reminders). WhatsApp is a stored
   * preference only — there is no WhatsApp sender in this codebase yet, so
   * the flag records intent and the UI says so rather than implying reminders
   * are going out on a channel nothing delivers to.
   */
  reminderEmailEnabled    Boolean @default(true)
  reminderWhatsappEnabled Boolean @default(false)

  /**
   * Pre-fills the Location field wherever one is picked while creating a
   * record (Stock, Products, Invoices, Purchases, ...), so a single-location
   * store never has to pick the same one every time. Set to the "Main
   * Counter" location created at registration; changeable afterward from
   * Settings > Locations. Named relation since StoreLocation.store (the
   * ownership FK) is a second, separate relation between these two models.
   */
  defaultLocationId String?
  defaultLocation   StoreLocation? @relation("StoreDefaultLocation", fields: [defaultLocationId], references: [id])

  /**
   * Store Owner Authorization — a SUPER_ADMIN has NO access to this store's
   * business data (can't switch into it via the store switcher, can't act
   * on it via any store-scoped action) until the owner shares this code and
   * a Super Admin redeems it (see StoreCollaborationAccess). Plaintext and
   * persistently visible in Settings > Collaboration — unlike ApiKey's
   * reveal-once secret, the owner needs to re-read/re-share it later, so
   * hashing it the way ApiKey/InviteToken do would defeat the point. Null
   * until first generated. `collaborationCodeVersion` is the actual
   * revocation mechanism: "Generate Code" overwrites the code AND bumps
   * this, and a StoreCollaborationAccess row only grants access while its
   * own snapshotted version still matches — so regenerating instantly
   * retires every previously-redeemed grant without deleting any rows.
   */
  collaborationCode            String?                    @unique
  collaborationCodeVersion     Int                        @default(0)
  collaborationCodeGeneratedAt DateTime?
  collaborationAccess          StoreCollaborationAccess[]
  accessRequests               StoreAccessRequest[]

  users                User[]
  userMemberships      UserStoreMembership[]
  planHistory          StorePlanHistory[]
  scanSessions         ScanSession[]
  customers            Customer[]
  karigars             Karigar[]
  products             Product[]
  inventoryStock       InventoryStock[]
  invoices             Invoice[]
  kachaInvoices        KachaInvoice[]
  ledgerEntries        LedgerEntry[]
  karigarJobs          KarigarJob[]
  metalRates           MetalRate[]
  businessSettings     BusinessSettings?
  inviteTokens         InviteToken[]
  vendors              Vendor[]
  purchases            Purchase[]
  purityFinenesses     PurityFineness[]
  caratConversionRates CaratConversionRate[]
  metalSellingRates    MetalSellingRate[]
  quotations           Quotation[]
  storeMetals          StoreMetal[]
  storeCategories      StoreCategory[]
  storeLocations       StoreLocation[]
  apiKeys              ApiKey[]
  supportTickets       SupportTicket[]
  creditNotes          CreditNote[]
  reminders            Reminder[]
  gstRates             GstRate[]
  draftOrders          DraftOrder[]

  @@index([code])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores  Store[]
  history StorePlanHistory[]
}

/**
 * How a plan period began.
 */
enum StorePlanAction {
  REGISTERED
  ASSIGNED
  RENEWED
}

/**
 * One row per plan period a store has held — the subscription ledger.
 * Needed because Store.planStartedAt/planExpiresAt are overwritten on every
 * assignment: without this table a renewal destroys the record of the period
 * it replaced, so "last renewal" and "history" cannot be answered at all.
 * planName, price and durationDays are snapshots rather than reads through
 * the relation. A plan can be renamed, repriced or deactivated, and history
 * has to keep saying what was actually sold at the time.
 */
model StorePlanHistory {
  id           String          @id @default(cuid())
  storeId      String
  planId       String?
  planName     String
  price        Decimal         @default(0) @db.Decimal(12, 2)
  durationDays Int
  startedAt    DateTime
  expiresAt    DateTime
  action       StorePlanAction @default(ASSIGNED)
  /**
   * Which Super Admin made the change; null for self-registration.
   */
  actorId      String?
  actorName    String?
  note         String?
  createdAt    DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan? @relation(fields: [planId], references: [id])

  @@index([storeId])
  @@index([startedAt])
}

model StoreLocation {
  id               String               @id @default(cuid())
  storeId          String
  name             String
  state            String?
  city             String?
  isActive         Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  store            Store                @relation(fields: [storeId], references: [id])
  // Back-relation for Store.defaultLocationId — practically ever at most one
  // Store (the one this location itself belongs to), never a real list.
  defaultForStores Store[]              @relation("StoreDefaultLocation")
  inventoryStocks  InventoryStock[]
  karigars         Karigar[]
  purchases        Purchase[]
  invoices         Invoice[]
  kachaInvoices    KachaInvoice[]
  karigarJobs      KarigarJob[]
  ledgerEntries    LedgerEntry[]
  quotations       Quotation[]
  userAccess       UserLocationAccess[]
  creditNotes      CreditNote[]
  reminders        Reminder[]
  draftOrders      DraftOrder[]

  @@unique([storeId, name])
}

/**
 * Grants a Staff user access to one or more locations. Mirrors the
 * User.permissions convention: zero rows for a user means unrestricted
 * (sees every location), same as an empty `permissions` array meaning
 * "not customized" falls back to full module access — the two axes are
 * independent (a module permission and a location grant), but both use
 * the same "empty = unrestricted" rule so they don't have to be reasoned
 * about differently. Only Staff is ever actually restricted — Admin/Super
 * Admin/Karigar are never gated by this table (Karigar's own scoping goes
 * through Karigar.locationId instead, since a User with role KARIGAR is
 * always 1:1 with a Karigar row via User.karigarId).
 */
/**
 * A person's access to one store. Someone who works across several stores
 * has one row per store, each carrying its own role and module permissions.
 * `User` stays globally unique on email and phone and is NOT duplicated per
 * store: the NextAuth Prisma adapter resolves Google sign-in through
 * `findUnique({ where: { email } })`, and OTP login does the same on phone,
 * so a second row for the same person would break authentication outright.
 * One login, many memberships.
 * `User.storeId` / `User.role` / `User.permissions` remain as the default
 * membership for accounts that predate this table, and are what a single-
 * store user still resolves to. Membership rows win when present.
 */
model UserStoreMembership {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  role        UserRole @default(STAFF)
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model UserLocationAccess {
  id         String        @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id])
  location   StoreLocation @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
}

model StoreMetal {
  id                  String               @id @default(cuid())
  storeId             String
  name                String
  hasPurity           Boolean              @default(false)
  // True for a gemstone row (Diamond, Ruby, Emerald, Sapphire, ...) managed
  // from Settings' Stones section rather than its Metals section — same
  // table, same metalTypeId FK everywhere, just a second lens onto it (see
  // the origins relation below and the Settings Taxonomy UI). This is now the
  // authoritative signal for "is this row a stone" wherever it's cheap to
  // plumb through (product-form.tsx's classifyPurityFamily); the older
  // name-substring heuristics (classifyMetalName, isCaratWeighedMetal) are
  // left alongside it rather than replaced everywhere they're called, since
  // several of those call sites only ever had a bare metal *name* string to
  // work with (historical ledger entries, purchase/invoice line items) —
  // see the comments on those functions for the reconciliation reasoning.
  isGemstone          Boolean              @default(false)
  // The unit this metal/stone's weight fields are always persisted in
  // (Settings > Taxonomy) — see the WeightUnit enum's own doc comment.
  // Defaults to GRAM; existing gemstone rows are backfilled to CARAT by the
  // migration that introduced this column, matching how they were already
  // implicitly treated everywhere carat-weighed math applied.
  primaryUnit         WeightUnit           @default(GRAM)
  // The store's configured default selling price per unit (per gram, or
  // per carat for a gemstone — whichever primaryUnit above says) for this
  // metal/stone — Settings > Taxonomy. Null means "not configured": Invoice
  // creation falls back to the linked stock item's own saleRate, and
  // failing that, plain manual entry — this is a default to save re-typing
  // the same rate on every sale, never a requirement.
  sellingPrice        Decimal?             @db.Decimal(12, 2)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  store               Store                @relation(fields: [storeId], references: [id])
  products            Product[]
  inventoryStocks     InventoryStock[]
  kachaInvoiceItems   KachaInvoiceItem[]
  invoiceItems        InvoiceItem[]
  ledgerEntries       LedgerEntry[]
  karigarJobs         KarigarJob[]
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  quotationItems      QuotationItem[]
  karigars            Karigar[]
  karigarAssignments  KarigarMetal[]
  // Only meaningful when isGemstone is true — the same one-to-many shape as
  // StoreCategory.types below. Replaces the old single nullable
  // StoreMetal.stoneOrigin column: a store dealing in BOTH natural and
  // lab-grown Diamond needs to express both as independently manageable
  // options under the one "Diamond" row, not two separate StoreMetal rows.
  // Free-text since 2026-09 (was a fixed Natural/Lab-Grown enum — see
  // StoreMetalOrigin's own doc comment). See Product.stoneOriginOptionId for
  // how a product picks exactly one.
  origins             StoreMetalOrigin[]
  draftOrderItems     DraftOrderItem[]

  @@unique([storeId, name])
}

// A single Stone Type option under a gemstone StoreMetal row (Diamond,
// Ruby, ...) — mirrors StoreCategoryType's shape/role under StoreCategory
// exactly, including being free-text (`name`), Store-Admin-managed, not
// restricted to a predefined set. Only ever created for a row with
// isGemstone=true; nothing enforces that at the DB level, same as
// StoreCategoryType not enforcing its parent is any particular kind of
// category — the taxonomy actions gate it instead.
//
// Was a fixed `origin: StoneOrigin` enum (NATURAL/LAB_GROWN only) until
// 2026-09, when it was converted to free text so a Store Admin can add any
// Stone Type they deal in (Natural, Lab-Grown, Moissanite, ...) the same way
// they already add Category Types — see the hand-written migration
// `20260903080000_convert_stone_origin_to_free_text` for the backfill of
// existing NATURAL/LAB_GROWN rows into `name` values.
model StoreMetalOrigin {
  id           String     @id @default(cuid())
  storeId      String
  storeMetalId String
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  storeMetal   StoreMetal @relation(fields: [storeMetalId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([storeMetalId, name])
}

model StoreCategory {
  id        String              @id @default(cuid())
  storeId   String
  name      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  store     Store               @relation(fields: [storeId], references: [id])
  types     StoreCategoryType[]
  products  Product[]

  @@unique([storeId, name])
}

model StoreCategoryType {
  id         String        @id @default(cuid())
  storeId    String
  categoryId String
  name       String
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
}

model Customer {
  id             String         @id @default(cuid())
  storeId        String
  customerCode   String?
  name           String
  phone          String?
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?
  // This customer's OWN GST registration status — independent of the
  // store's own gstScheme. See PartyGstType's doc comment: it only ever
  // affects whether GSTIN is required/shown here, never how much GST the
  // store itself charges (that's fixed by BusinessSettings.gstScheme).
  // Defaults new records to whatever the store's own gstScheme suggests is
  // more likely, but is freely editable per customer afterward. See
  // gstinRequired() in lib/gst.ts.
  gstType        PartyGstType   @default(UNREGISTERED)
  panNumber      String?
  // Optional KYC id — validated (12 digits + Verhoeff checksum, see
  // lib/aadhaar.ts) only when actually entered.
  aadhaarNumber  String?
  // A customer-facing loyalty/scheme reference number some stores print on
  // the invoice (e.g. "Encircle Id") — opaque to the app, shown as-is.
  registrationId String?
  notes          String?
  openingBalance Decimal        @default(0) @db.Decimal(12, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isArchived     Boolean        @default(false)
  // Who created this record — the id is the link, the name a snapshot, same
  // convention as Invoice.createdById/createdByName. Nullable: customers
  // created before this was tracked genuinely have no answer, and an
  // API/MCP-created customer has no human User behind it at all.
  createdById    String?
  createdByName  String?
  // Optional link to a Vendor row representing the SAME real-world person
  // or business — lets someone the store both sells to and buys from (a
  // customer who also sells old gold back, a wholesaler who's also a
  // retail buyer) be recorded once on each side while staying connected.
  // The FK lives here rather than on both sides so there's one source of
  // truth for the pairing; @unique makes it a true 1:1 — at most one
  // Customer can claim a given Vendor. Each side keeps its own independent
  // invoices/purchases/ledger exactly as before; this is purely a display-
  // level cross-reference. See lib/actions/party-link-actions.ts.
  linkedVendorId String?        @unique
  linkedVendor   Vendor?        @relation("CustomerVendorLink", fields: [linkedVendorId], references: [id])
  createdBy      User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  store          Store          @relation(fields: [storeId], references: [id])
  invoices       Invoice[]
  kachaInvoices  KachaInvoice[]
  ledgerEntries  LedgerEntry[]
  quotations     Quotation[]
  creditNotes    CreditNote[]
  draftOrders    DraftOrder[]

  @@unique([storeId, customerCode])
  @@unique([storeId, phone])
  @@index([name])
  @@index([phone])
  @@index([customerCode])
  @@index([storeId])
  @@index([createdById])
}

model Karigar {
  id             String         @id @default(cuid())
  storeId        String
  code           String?
  name           String
  mobile         String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstNumber      String?
  // This karigar's own GST registration status — same PartyGstType used by
  // Customer/Vendor, same gstinRequired(storeGstScheme, gstType) rule
  // deciding whether gstNumber above is mandatory. Not tied to any tax
  // calculation of our own (a karigar is never invoiced), just kept
  // consistent with how the rest of the app records a party's own GST
  // registration.
  gstType        PartyGstType   @default(UNREGISTERED)
  panNumber      String?
  aadhaarNumber  String?
  specialization String?
  notes          String?
  // Profile photo, uploaded from the Add/Edit Artisan form — same Vercel
  // Blob pattern as User.image (see app/api/karigars/photo/route.ts).
  imageUrl       String?
  openingGold    Decimal        @default(0) @db.Decimal(12, 5)
  openingCash    Decimal        @default(0) @db.Decimal(12, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          Store          @relation(fields: [storeId], references: [id])
  karigarJobs    KarigarJob[]
  ledgerEntries  LedgerEntry[]
  loginUser      User?
  locationId     String?
  location       StoreLocation? @relation(fields: [locationId], references: [id])
  // The metal this karigar mainly works with (Gold/Silver/Diamond/...) —
  // distinct from `specialization`, which is a free-text craft description
  // ("Chain making", "Stone setting"). Optional: only drives the Karigars
  // page's Type filter, same classifyPurityFamily grouping the Stock page's
  // Type filter already uses.
  metalTypeId    String?
  metalType      StoreMetal?    @relation(fields: [metalTypeId], references: [id])
  // Which metals/stones this karigar is actually assigned to work with —
  // unlike metalTypeId above (a single "mainly works with" label for the
  // Type filter), this is the list Issue/Receive Material actually gate
  // against: a job can only be raised in a metal this karigar is assigned
  // to. See KarigarMetal.
  assignedMetals KarigarMetal[]

  @@unique([storeId, code])
  @@index([name])
  @@index([metalTypeId])
  @@index([mobile])
  @@index([code])
  @@index([locationId])
  @@index([storeId])
}

/**
 * One row per metal/stone a karigar is assigned to work with — a karigar
 * can be assigned several (e.g. Gold and Silver but not Diamond), and
 * Issue/Receive Material only ever offers metals present here for that
 * karigar. Deliberately separate from Karigar.metalTypeId, which is just a
 * single "mainly works with" label driving the Karigars list's Type filter
 * and carries no such restriction.
 */
model KarigarMetal {
  id          String     @id @default(cuid())
  karigarId   String
  metalTypeId String
  createdAt   DateTime   @default(now())
  karigar     Karigar    @relation(fields: [karigarId], references: [id], onDelete: Cascade)
  metalType   StoreMetal @relation(fields: [metalTypeId], references: [id])

  @@unique([karigarId, metalTypeId])
  @@index([karigarId])
  @@index([metalTypeId])
}

model Product {
  id                        String               @id @default(cuid())
  storeId                   String
  // Doubles as this product's SKU — auto-generated at creation from Metal +
  // Purity + Target Style + Category Type (e.g. "G22-LR-001" for a Gold 22K
  // Ladies Ring), never hand-typed or regenerated afterward (see
  // generateProductSku() in lib/actions/inventory/product-actions.ts).
  // Products created before this scheme shipped keep whatever code they
  // already had — this was a plain manually-typed field until then, so an
  // older value may not follow the structured format at all.
  productCode               String
  name                      String
  categoryId                String?
  categoryTypeId            String?
  metalTypeId               String?
  // "Ladies"/"Gents"/"Kids"/"Unisex" — see TargetStyle's own doc comment.
  // Nullable so pre-existing products (created before this field shipped)
  // aren't retroactively forced to pick one; the create form requires it
  // for every new product since the SKU generator needs it.
  targetStyle               TargetStyle?
  // Only meaningful when metalType.isGemstone is true — mirrors
  // categoryTypeId's role exactly: metalTypeId stays the stone selector
  // (Diamond, Ruby, ...), this is the finer-grained pick of which of that
  // stone's Store-Admin-defined Stone Type options (Natural, Lab-Grown,
  // Moissanite, or whatever else the store has added — see
  // StoreMetalOrigin) this product is.
  stoneOriginOptionId       String?
  defaultPurity             PurityType?
  defaultMakingCharge       Decimal?             @db.Decimal(12, 2)
  defaultMakingChargeType   ChargeType           @default(FIXED)
  defaultStoneCharge        Decimal?             @db.Decimal(12, 2)
  defaultStoneChargeType    ChargeType           @default(FIXED)
  // Typical weights for this design, used to prefill a stock entry rather
  // than to describe any one piece — two rings off the same design are never
  // identical to the milligram, so the per-piece truth stays on
  // InventoryStock. Same Decimal(12, 5) as the columns they seed.
  defaultGrossWeight        Decimal?             @db.Decimal(12, 5)
  defaultNetWeight          Decimal?             @db.Decimal(12, 5)
  defaultStoneWeight        Decimal?             @db.Decimal(12, 5)
  defaultCaratWeight        Decimal?             @db.Decimal(10, 3)
  // A composite piece — one metal (priced by weight, unchanged) plus one
  // embedded stone/diamond component (priced by defaultStoneRate × the
  // existing defaultCaratWeight above, auto-summed into Stone Charge)
  // rather than a flat manually-typed Stone Charge. Distinct from a line
  // whose own metal IS Diamond/Stone (isCaratWeighedMetal) — that's a
  // single carat-priced item, not a metal+stone combination.
  hasStoneComponent         Boolean              @default(false)
  defaultStoneRate          Decimal?             @db.Decimal(12, 2)
  // Which Stone (a StoreMetal row, e.g. "Diamond") and which of its Stone
  // Type options (StoreMetalOrigin rows, e.g. "Natural, Lab-Grown" — comma
  // joined, several may apply to one embedded stone) — plain denormalized
  // names rather than FKs, same convention as vendorName/createdByName
  // elsewhere: this is a descriptive label on the line, not something
  // queried/joined on, so a real relation (times six tables) would be
  // more machinery than the data warrants. Only meaningful alongside
  // hasStoneComponent.
  defaultStoneMetalTypeName String?
  defaultStoneTypeNames     String?
  designCode                String?
  hsnCode                   String?
  description               String?
  notes                     String?
  isActive                  Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  store                     Store                @relation(fields: [storeId], references: [id])
  stockItems                InventoryStock[]
  purchaseItems             PurchaseItem[]
  karigarReceiptItems       KarigarReceiptItem[]
  category                  StoreCategory?       @relation(fields: [categoryId], references: [id])
  categoryType              StoreCategoryType?   @relation(fields: [categoryTypeId], references: [id])
  metalType                 StoreMetal?          @relation(fields: [metalTypeId], references: [id])
  stoneOriginOption         StoreMetalOrigin?    @relation(fields: [stoneOriginOptionId], references: [id])

  @@unique([storeId, productCode])
  @@index([categoryId])
  @@index([categoryTypeId])
  @@index([metalTypeId])
  @@index([stoneOriginOptionId])
  @@index([name])
  @@index([productCode])
  @@index([designCode])
  @@index([storeId])
}

model InventoryStock {
  id                  String                 @id @default(cuid())
  storeId             String
  stockCode           String
  tagNumber           String?
  productId           String
  metalTypeId         String?
  purity              PurityType?
  quantity            Int                    @default(1)
  status              InventoryStockStatus   @default(IN_STOCK)
  finish              InventoryFinish        @default(KACHA)
  isActive            Boolean                @default(true)
  grossWeight         Decimal?               @db.Decimal(12, 5)
  lessWeight          Decimal?               @db.Decimal(12, 5)
  netWeight           Decimal?               @db.Decimal(12, 5)
  stoneWeight         Decimal?               @db.Decimal(12, 5)
  dmoWeight           Decimal?               @db.Decimal(12, 5)
  // Diamond weight in carats — a distinct unit from every gram-based weight
  // above, only meaningful when purity is DIAMOND. Rate then prices per
  // carat, not per gram (see toLineQuantity in the *-actions.ts files).
  caratWeight         Decimal?               @db.Decimal(10, 3)
  wastagePercent      Decimal?               @db.Decimal(5, 2)
  purchaseRate        Decimal?               @db.Decimal(12, 2)
  saleRate            Decimal?               @db.Decimal(12, 2)
  makingCharge        Decimal?               @db.Decimal(12, 2)
  makingChargeType    ChargeType             @default(FIXED)
  stoneCharge         Decimal?               @db.Decimal(12, 2)
  // Rate per carat for this piece's embedded stone/diamond (composite
  // items — metal priced by weight as usual, stone priced by
  // stoneRate × caratWeight, summed into stoneCharge). No boolean flag
  // needed at the stock level — a non-null caratWeight/stoneRate here is
  // signal enough.
  stoneRate           Decimal?               @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName  String?
  stoneTypeNames      String?
  otherCharge         Decimal?               @db.Decimal(12, 2)
  purchaseAmount      Decimal?               @db.Decimal(12, 2)
  saleAmount          Decimal?               @db.Decimal(12, 2)
  vendorName          String?
  purchaseDate        DateTime?
  manufactureDate     DateTime?
  locationId          String?
  remarks             String?
  // Who manually added this stock row — only meaningful for a manual add
  // (see createInventoryStock's own comment: "no vendor/karigar
  // counterparty"). A row created from a Purchase or a karigar job's
  // receipt is instead attributed via that Purchase's own createdBy or the
  // karigarJobs relation below — see getItemLedgerReport's addedByLabel()
  // for the priority order. Name/role are durable snapshots (same
  // convention as Invoice.createdByName) since a user can be renamed,
  // promoted, or deleted after adding this item.
  createdById         String?
  createdByName       String?
  createdByRole       UserRole?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  store               Store                  @relation(fields: [storeId], references: [id])
  product             Product                @relation(fields: [productId], references: [id])
  transactions        InventoryTransaction[]
  invoiceItems        InvoiceItem[]
  kachaInvoiceItems   KachaInvoiceItem[]
  karigarJobs         KarigarJob[]
  vendor              Vendor?                @relation(fields: [vendorId], references: [id])
  vendorId            String?
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  quotationItems      QuotationItem[]
  metalType           StoreMetal?            @relation(fields: [metalTypeId], references: [id])
  location            StoreLocation?         @relation(fields: [locationId], references: [id])
  createdBy           User?                  @relation("InventoryStockCreatedBy", fields: [createdById], references: [id])
  creditNoteItems     CreditNoteItem[]

  @@unique([storeId, stockCode])
  @@unique([storeId, tagNumber])
  @@index([stockCode])
  @@index([tagNumber])
  @@index([productId])
  @@index([metalTypeId])
  @@index([purity])
  @@index([status])
  @@index([finish])
  @@index([purchaseDate])
  @@index([locationId])
  @@index([vendorId])
  @@index([storeId])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  inventoryStockId String
  transactionType  InventoryTransactionType
  quantity         Int                      @default(1)
  grossWeight      Decimal?                 @db.Decimal(12, 5)
  netWeight        Decimal?                 @db.Decimal(12, 5)
  referenceType    String?
  referenceId      String?
  notes            String?
  createdAt        DateTime                 @default(now())
  inventoryStock   InventoryStock           @relation(fields: [inventoryStockId], references: [id], onDelete: Cascade)

  @@index([inventoryStockId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Invoice {
  id                     String         @id @default(cuid())
  storeId                String
  invoiceNumber          String
  customerId             String
  invoiceDate            DateTime       @default(now())
  dueDate                DateTime?
  status                 InvoiceStatus  @default(PAID)
  subtotal               Decimal        @default(0) @db.Decimal(12, 2)
  makingCharges          Decimal        @default(0) @db.Decimal(12, 2)
  stoneCharges           Decimal        @default(0) @db.Decimal(12, 2)
  discount               Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount              Decimal        @default(0) @db.Decimal(12, 2)
  // Which configured GstRate (Settings > GST Rates) was picked, snapshotted
  // at the time — see GstRate's own doc comment for why this is a snapshot
  // rather than a live read of the master rate. Nullable: an invoice raised
  // before this field existed, or a Composition-scheme store's invoice
  // (never carries a rate at all), has none.
  gstRateId              String?
  gstRateName            String?
  gstRatePercent         Decimal?       @db.Decimal(5, 2)
  // The adjustment applied to round totalAmount to the nearest whole rupee —
  // see lib/round-off.ts's computeRoundOff(). Positive when the raw total
  // rounded up, negative when it rounded down; zero on a total that was
  // already a whole rupee. Always derived server-side from the same figures
  // that produce totalAmount, never trusted from the client.
  roundOffAmount         Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount             Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount          Decimal        @default(0) @db.Decimal(12, 2)
  notes                  String?
  // Who raised it. The id is the link; the name is a snapshot, because staff
  // leave and get renamed and an invoice has to keep saying who sold it.
  // Nullable: invoices raised before this was recorded genuinely have no
  // answer, and inventing one would be worse than showing none.
  createdById            String?
  createdByName          String?
  // Set when this invoice is cancelled via cancelInvoice — the id/name
  // snapshot follows the same convention as createdById/createdByName,
  // for the same reason (staff leave and get renamed).
  cancelledAt            DateTime?
  cancelledById          String?
  cancelledByName        String?
  cancellationReason     String?
  // E-way Bill — record-keeping only. This app never calls the government's
  // E-way Bill API (no GSP/NIC credentials involved); the store still
  // generates the actual bill on ewaybillgst.gov.in and enters its number
  // back here, purely so it prints on the invoice and travels with the
  // shipment's paperwork. See EditInvoiceDialog, available on every
  // non-cancelled invoice regardless of payment status — E-way Bills are
  // usually generated at dispatch, not necessarily at billing time.
  ewayBillNumber         String?
  ewayBillDate           DateTime?
  transporterName        String?
  vehicleNumber          String?
  transportMode          TransportMode?
  distanceKm             Int?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  store                  Store          @relation(fields: [storeId], references: [id])
  createdBy              User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledBy            User?          @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  customer               Customer       @relation(fields: [customerId], references: [id])
  gstRate                GstRate?       @relation(fields: [gstRateId], references: [id])
  items                  InvoiceItem[]
  ledgerEntries          LedgerEntry[]
  convertedFromKacha     KachaInvoice?  @relation("KachaConvertedToPakka")
  convertedFromQuotation Quotation?     @relation("QuotationConvertedToInvoice")
  locationId             String?
  location               StoreLocation? @relation(fields: [locationId], references: [id])
  // Self-relation for "this invoice was raised to replace a cancelled
  // one" — replacesId lives on the new invoice (same source-owns-the-FK
  // convention as KachaInvoice.convertedToId/Quotation.convertedToId
  // pointing at Invoice), @unique so a cancelled invoice can be replaced
  // by at most one new invoice.
  replacesId             String?        @unique
  replaces               Invoice?       @relation("InvoiceReplaces", fields: [replacesId], references: [id])
  replacedBy             Invoice?       @relation("InvoiceReplaces")
  creditNotes            CreditNote[]

  @@unique([storeId, invoiceNumber])
  @@index([createdById])
  @@index([cancelledById])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([invoiceNumber])
  @@index([storeId])
  @@index([locationId])
}

/// A return against a PAID/PARTIAL invoice, raised within the store's
/// configured returnWindowDays (BusinessSettings) of that invoice's
/// invoiceDate — see lib/actions/credit-note-actions.ts's isReturnEligible().
/// Deliberately its own document (own number series, own date), not a
/// mutation of the original Invoice: the invoice must keep saying what was
/// actually billed/received historically, same reasoning as
/// Invoice.cancelledAt leaving totalAmount/paidAmount untouched and
/// explaining itself via an offsetting LedgerEntry instead.
model CreditNote {
  id               String   @id @default(cuid())
  storeId          String
  creditNoteNumber String
  invoiceId        String
  customerId       String
  creditNoteDate   DateTime @default(now())
  reason           String?
  totalAmount      Decimal  @default(0) @db.Decimal(12, 2)
  notes            String?
  // Same id/name-snapshot convention as Invoice.createdById/createdByName —
  // staff leave and get renamed, and a credit note has to keep saying who
  // processed it.
  createdById      String?
  createdByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  store         Store            @relation(fields: [storeId], references: [id])
  invoice       Invoice          @relation(fields: [invoiceId], references: [id])
  customer      Customer         @relation(fields: [customerId], references: [id])
  createdBy     User?            @relation("CreditNoteCreatedBy", fields: [createdById], references: [id])
  items         CreditNoteItem[]
  ledgerEntries LedgerEntry[]
  locationId    String?
  location      StoreLocation?   @relation(fields: [locationId], references: [id])

  @@unique([storeId, creditNoteNumber])
  @@index([creditNoteNumber])
  @@index([invoiceId])
  @@index([customerId])
  @@index([storeId])
  @@index([locationId])
}

/// One returned line, snapshotting the InvoiceItem it came from — quantity
/// here is how many of that line's pieces this particular credit note
/// covers, which can be less than the original quantity, and a second
/// return against the same invoice line is only blocked from exceeding
/// what's left by summing prior CreditNoteItem rows for the same
/// invoiceItemId (see getReturnableQuantity in credit-note-actions.ts) —
/// no denormalized "remaining" counter is kept on InvoiceItem itself, to
/// avoid it drifting out of sync with the credit notes that are the actual
/// source of truth.
model CreditNoteItem {
  id               String   @id @default(cuid())
  creditNoteId     String
  invoiceItemId    String
  inventoryStockId String?
  itemName         String
  quantity         Int      @default(1)
  rate             Decimal? @db.Decimal(12, 2)
  lineTotal        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt        DateTime @default(now())

  creditNote     CreditNote      @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  invoiceItem    InvoiceItem     @relation(fields: [invoiceItemId], references: [id])
  inventoryStock InventoryStock? @relation(fields: [inventoryStockId], references: [id])

  @@index([creditNoteId])
  @@index([invoiceItemId])
  @@index([inventoryStockId])
}

/// A free-form, manually-added reminder for the Calendar View — the catch-all
/// for "other important tasks/deadlines" that don't already have a date
/// field somewhere else in the schema (Invoice.dueDate, Quotation.validUntil,
/// KarigarJob.expectedDate, Store.planExpiresAt — see
/// lib/actions/calendar-actions.ts's getCalendarEvents, which merges all of
/// these into one feed). Not itself tied to any other record on purpose:
/// a reminder here is exactly the kind of thing that has no natural home
/// elsewhere.
model Reminder {
  id            String   @id @default(cuid())
  storeId       String
  title         String
  notes         String?
  dueDate       DateTime
  isDone        Boolean  @default(false)
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  store      Store          @relation(fields: [storeId], references: [id])
  createdBy  User?          @relation("ReminderCreatedBy", fields: [createdById], references: [id])
  locationId String?
  location   StoreLocation? @relation(fields: [locationId], references: [id])

  @@index([storeId])
  @@index([dueDate])
  @@index([locationId])
}

model KachaInvoice {
  id             String             @id @default(cuid())
  storeId        String
  slipNumber     String
  customerId     String
  invoiceDate    DateTime           @default(now())
  status         InvoiceStatus      @default(PAID)
  subtotal       Decimal            @default(0) @db.Decimal(12, 2)
  makingCharges  Decimal            @default(0) @db.Decimal(12, 2)
  stoneCharges   Decimal            @default(0) @db.Decimal(12, 2)
  discount       Decimal            @default(0) @db.Decimal(12, 2)
  // See Invoice.roundOffAmount's own doc comment — same convention.
  roundOffAmount Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal            @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal            @default(0) @db.Decimal(12, 2)
  balanceAmount  Decimal            @default(0) @db.Decimal(12, 2)
  notes          String?
  convertedToId  String?            @unique
  convertedTo    Invoice?           @relation("KachaConvertedToPakka", fields: [convertedToId], references: [id])
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  store          Store              @relation(fields: [storeId], references: [id])
  customer       Customer           @relation(fields: [customerId], references: [id])
  items          KachaInvoiceItem[]
  locationId     String?
  location       StoreLocation?     @relation(fields: [locationId], references: [id])

  @@unique([storeId, slipNumber])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([slipNumber])
  @@index([storeId])
  @@index([locationId])
}

model KachaInvoiceItem {
  id                 String          @id @default(cuid())
  kachaInvoiceId     String
  itemName           String
  metalTypeId        String?
  purity             PurityType?
  quantity           Int             @default(1)
  grossWeight        Decimal?        @db.Decimal(12, 5)
  netWeight          Decimal?        @db.Decimal(12, 5)
  dmoWeight          Decimal?        @db.Decimal(12, 5)
  stoneWeight        Decimal?        @db.Decimal(12, 5)
  caratWeight        Decimal?        @db.Decimal(10, 3)
  rate               Decimal?        @db.Decimal(12, 2)
  makingCharge       Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType   ChargeType      @default(FIXED)
  // Hallmarking charge, folded into the slip's Making Charges total — same
  // convention as InvoiceItem.hmCharge's own doc comment.
  hmCharge           Decimal         @default(0) @db.Decimal(12, 2)
  stoneCharge        Decimal         @default(0) @db.Decimal(12, 2)
  stoneRate          Decimal?        @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName String?
  stoneTypeNames     String?
  lineTotal          Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryStock     InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  kachaInvoice       KachaInvoice    @relation(fields: [kachaInvoiceId], references: [id], onDelete: Cascade)
  metalType          StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([kachaInvoiceId])
  @@index([inventoryStockId])
}

model InvoiceItem {
  id                 String           @id @default(cuid())
  invoiceId          String
  itemName           String
  metalTypeId        String?
  quantity           Int              @default(1)
  grossWeight        Decimal?         @db.Decimal(12, 5)
  netWeight          Decimal?         @db.Decimal(12, 5)
  dmoWeight          Decimal?         @db.Decimal(12, 5)
  // Net stone weight (carats or grams, store's choice — same free-typed
  // convention as every other weight field), separate from dmoWeight (which
  // is Dust/Making/Other, not stone).
  stoneWeight        Decimal?         @db.Decimal(12, 5)
  // Diamond weight in carats, only meaningful when purity is DIAMOND — a
  // dedicated, unambiguous unit (unlike stoneWeight above), since rate then
  // prices per carat rather than per gram.
  caratWeight        Decimal?         @db.Decimal(10, 3)
  rate               Decimal?         @db.Decimal(12, 2)
  makingCharge       Decimal          @default(0) @db.Decimal(12, 2)
  makingChargeType   ChargeType       @default(FIXED)
  // Hallmarking charge, shown as its own line under Making Charges on the
  // printed invoice — distinct from makingCharge itself.
  hmCharge           Decimal          @default(0) @db.Decimal(12, 2)
  stoneCharge        Decimal          @default(0) @db.Decimal(12, 2)
  stoneRate          Decimal?         @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName String?
  stoneTypeNames     String?
  // Per-line scheme/discount amount, separate from Invoice.discount (which
  // is an invoice-level total) — the printed format wants one column per
  // line, not a single amount split across items after the fact.
  schemeDiscount     Decimal          @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal          @default(0) @db.Decimal(12, 2)
  cgstAmount         Decimal          @default(0) @db.Decimal(12, 2)
  // Charged instead of sgstAmount+cgstAmount when the sale is inter-state
  // (customer's state differs from the store's own) - never both at once,
  // see computeGst() in lib/gst.ts. Always 0 for a Composition-scheme store,
  // same as sgst/cgst - a composition dealer never itemizes GST at all.
  igstAmount         Decimal          @default(0) @db.Decimal(12, 2)
  // Which configured GstRate (Settings > GST Rates) this specific LINE used
  // — GST is picked per line, not once for the whole invoice, since a
  // single document can genuinely mix e.g. a 3% metal line with an 18%
  // service line. Snapshotted the same way as Invoice's own (now-legacy)
  // gstRateId trio: never rewritten by a later change/deactivation of the
  // master rate. Nullable for the same reasons as there — a Composition-
  // scheme line, or a row saved before this field existed.
  gstRateId          String?
  gstRateName        String?
  gstRatePercent     Decimal?         @db.Decimal(5, 2)
  // HSN snapshot at sale time — Product.hsnCode can change later, and a
  // manually-entered line (no linked stock/product) has no HSN otherwise.
  hsnCode            String?
  lineTotal          Decimal          @default(0) @db.Decimal(12, 2)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  inventoryStockId   String?
  purity             PurityType?
  inventoryStock     InventoryStock?  @relation(fields: [inventoryStockId], references: [id])
  invoice            Invoice          @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  metalType          StoreMetal?      @relation(fields: [metalTypeId], references: [id])
  gstRate            GstRate?         @relation(fields: [gstRateId], references: [id])
  creditNoteItems    CreditNoteItem[]

  @@index([invoiceId])
  @@index([inventoryStockId])
  @@index([gstRateId])
}

model LedgerEntry {
  id               String           @id @default(cuid())
  storeId          String
  entryDate        DateTime         @default(now())
  type             LedgerEntryType
  sourceType       LedgerSourceType @default(MANUAL)
  customerId       String?
  karigarId        String?
  invoiceId        String?
  creditNoteId     String?
  purchaseId       String?
  vendorId         String?
  metalTypeId      String?
  metalWeight      Decimal?         @db.Decimal(12, 5)
  metalWeightFine  Decimal?         @db.Decimal(12, 5)
  // Diamond entries are carat-based, not weight-based — metalWeight/
  // metalWeightFine stay null for them (same 12,5 columns other metals use
  // in grams would be the wrong unit). Matches the caratWeight precision
  // already used on PurchaseItem/InvoiceItem/KachaInvoiceItem/QuotationItem/
  // Product/InventoryStock (see the 20260901193000 migration).
  caratWeight      Decimal?         @db.Decimal(10, 3)
  amount           Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?
  paymentReference String?
  bankName         String?
  attachmentUrl    String?
  description      String?
  // Who recorded this entry — nullable since it was added after entries
  // already existed (those show no creator, rather than a guessed one).
  createdByUserId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  store            Store            @relation(fields: [storeId], references: [id])
  createdBy        User?            @relation("LedgerEntryCreatedBy", fields: [createdByUserId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  creditNote       CreditNote?      @relation(fields: [creditNoteId], references: [id])
  karigar          Karigar?         @relation(fields: [karigarId], references: [id])
  purchase         Purchase?        @relation(fields: [purchaseId], references: [id])
  vendor           Vendor?          @relation(fields: [vendorId], references: [id])
  metalType        StoreMetal?      @relation(fields: [metalTypeId], references: [id])
  locationId       String?
  location         StoreLocation?   @relation(fields: [locationId], references: [id])

  @@index([entryDate])
  @@index([customerId])
  @@index([karigarId])
  @@index([invoiceId])
  @@index([creditNoteId])
  @@index([purchaseId])
  @@index([vendorId])
  @@index([type])
  @@index([sourceType])
  @@index([storeId])
  @@index([locationId])
}

model KarigarJob {
  id                String               @id @default(cuid())
  storeId           String
  jobNumber         String?
  karigarId         String
  issueDate         DateTime             @default(now())
  expectedDate      DateTime?
  receivedDate      DateTime?
  metalTypeId       String?
  issueWeight       Decimal?             @db.Decimal(12, 5)
  issuePurity       PurityType?
  issueFineWeight   Decimal?             @db.Decimal(12, 5)
  receiveWeight     Decimal?             @db.Decimal(12, 5)
  receiveFineWeight Decimal?             @db.Decimal(12, 5)
  labourCharge      Decimal              @default(0) @db.Decimal(12, 2)
  status            String               @default("issued")
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  inventoryStockId  String?
  store             Store                @relation(fields: [storeId], references: [id])
  inventoryStock    InventoryStock?      @relation(fields: [inventoryStockId], references: [id])
  karigar           Karigar              @relation(fields: [karigarId], references: [id])
  receiptItems      KarigarReceiptItem[]
  metalType         StoreMetal?          @relation(fields: [metalTypeId], references: [id])
  locationId        String?
  location          StoreLocation?       @relation(fields: [locationId], references: [id])
  // Back-relation for DraftOrder.karigarJobId — the FK lives on DraftOrder
  // (a job is issued to fulfil at most one Draft Order in this pass; see
  // DraftOrder's own doc comment).
  draftOrder        DraftOrder?

  @@unique([storeId, jobNumber])
  @@index([inventoryStockId])
  @@index([issueDate])
  @@index([jobNumber])
  @@index([karigarId])
  @@index([storeId])
  @@index([locationId])
}

model Vendor {
  id             String           @id @default(cuid())
  storeId        String
  vendorCode     String?
  name           String
  phone          String?
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?
  // This vendor's OWN GST registration status. Unlike on Customer, this
  // genuinely changes the tax math: a COMPOSITION vendor's purchase invoice
  // to us legally never carries GST, regardless of our own store's
  // gstScheme - see isVendorGstApplicable() in lib/gst.ts, used by the
  // Purchases form/action instead of the store's own scheme.
  gstType        PartyGstType     @default(UNREGISTERED)
  // Optional KYC id — validated (12 digits + Verhoeff checksum, see
  // lib/aadhaar.ts) only when actually entered.
  aadhaarNumber  String?
  notes          String?
  openingBalance Decimal          @default(0) @db.Decimal(12, 2)
  isActive       Boolean          @default(true)
  isArchived     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  store          Store            @relation(fields: [storeId], references: [id])
  purchases      Purchase[]
  ledgerEntries  LedgerEntry[]
  inventoryStock InventoryStock[]
  // Back-relation for Customer.linkedVendorId — see that field's doc
  // comment. At most one Customer can hold this link (enforced there by
  // @unique on linkedVendorId), so this is a real 1:1, not a list.
  linkedCustomer Customer?        @relation("CustomerVendorLink")

  @@unique([storeId, vendorCode])
  @@index([name])
  @@index([phone])
  @@index([storeId])
}

model Purchase {
  id                  String         @id @default(cuid())
  storeId             String
  purchaseNumber      String
  /// The vendor's own invoice/bill number for this purchase — a free-typed
  /// reference (not generated, not unique), so it can be matched back
  /// against the physical bill the vendor issued.
  vendorInvoiceNumber String?
  vendorId            String
  purchaseDate        DateTime       @default(now())
  status              InvoiceStatus  @default(PAID)
  subtotal            Decimal        @default(0) @db.Decimal(12, 2)
  makingCharges       Decimal        @default(0) @db.Decimal(12, 2)
  stoneCharges        Decimal        @default(0) @db.Decimal(12, 2)
  discount            Decimal        @default(0) @db.Decimal(12, 2)
  // Whatever GST the vendor actually charged on their bill - driven by the
  // VENDOR's own PartyGstType (see computePurchaseGst()/
  // isVendorGstApplicable() in lib/gst.ts), not the store's own gstScheme,
  // so it's recorded the same way regardless of which of the three schemes
  // the store itself operates under. What DOES depend on the store's scheme
  // is whether this is eligible for input tax credit: a Composition-scheme
  // store can never claim ITC on anything, no matter what a vendor charged
  // - see the "ITC not eligible" note rendered wherever this purchase is
  // shown (isItcEligible() in lib/gst.ts).
  // Document-level totals, now derived by summing every PurchaseItem's own
  // sgst/cgst/igst — GST is picked per line, not once for the whole
  // purchase (see PurchaseItem.gstRateId's own doc comment), the same
  // change Invoice went through first.
  taxAmount           Decimal        @default(0) @db.Decimal(12, 2)
  sgstAmount          Decimal        @default(0) @db.Decimal(12, 2)
  cgstAmount          Decimal        @default(0) @db.Decimal(12, 2)
  igstAmount          Decimal        @default(0) @db.Decimal(12, 2)
  // Legacy snapshot only — no longer a real user-facing selection (each
  // line resolves its own via PurchaseItem.gstRateId instead). Kept for
  // whatever historical purchases and reports still read it, same as
  // Invoice's own now-legacy gstRateId trio. Nullable: a purchase raised
  // before this field existed, or one where the vendor charges no GST at
  // all (isVendorGstApplicable), has none.
  gstRateId           String?
  gstRateName         String?
  gstRatePercent      Decimal?       @db.Decimal(5, 2)
  // See Invoice.roundOffAmount's own doc comment — same convention.
  roundOffAmount      Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount          Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount       Decimal        @default(0) @db.Decimal(12, 2)
  notes               String?
  // Which staff member recorded this purchase — previously untracked (see
  // getItemLedgerReport's own former comment on why "Purchased by" always
  // read "Not recorded"). Name/role are durable snapshots, same convention
  // as Invoice.createdByName.
  createdById         String?
  createdByName       String?
  createdByRole       UserRole?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  store               Store          @relation(fields: [storeId], references: [id])
  vendor              Vendor         @relation(fields: [vendorId], references: [id])
  gstRate             GstRate?       @relation(fields: [gstRateId], references: [id])
  items               PurchaseItem[]
  ledgerEntries       LedgerEntry[]
  locationId          String?
  location            StoreLocation? @relation(fields: [locationId], references: [id])
  createdBy           User?          @relation("PurchaseCreatedBy", fields: [createdById], references: [id])

  @@unique([storeId, purchaseNumber])
  @@index([vendorId])
  @@index([purchaseDate])
  @@index([status])
  @@index([storeId])
  @@index([locationId])
}

model PurchaseItem {
  id                 String          @id @default(cuid())
  purchaseId         String
  productId          String
  itemName           String
  metalTypeId        String?
  purity             PurityType?
  quantity           Int             @default(1)
  grossWeight        Decimal?        @db.Decimal(12, 5)
  netWeight          Decimal?        @db.Decimal(12, 5)
  dmoWeight          Decimal?        @db.Decimal(12, 5)
  stoneWeight        Decimal?        @db.Decimal(12, 5)
  caratWeight        Decimal?        @db.Decimal(10, 3)
  rate               Decimal?        @db.Decimal(12, 2)
  makingCharge       Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType   ChargeType      @default(FIXED)
  stoneCharge        Decimal         @default(0) @db.Decimal(12, 2)
  stoneRate          Decimal?        @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName String?
  stoneTypeNames     String?
  // HSN snapshot at purchase time - same reasoning as InvoiceItem.hsnCode:
  // Product.hsnCode can change later, and this line might not even have a
  // linked product yet at the time of entry.
  hsnCode            String?
  sgstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  cgstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  // Charged instead of sgst+cgst on an inter-state purchase — see
  // computePurchaseGst() in lib/gst.ts. Never both nonzero on the same line.
  igstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  // Which configured GstRate (Settings > GST Rates) THIS line uses — GST is
  // picked per line, not once for the whole purchase (a single vendor bill
  // can genuinely mix rates across items), mirroring
  // InvoiceItem.gstRateId's own doc comment. Nullable: a line saved before
  // this field existed, or one where the vendor isn't GST-applicable
  // (isVendorGstApplicable), has none.
  gstRateId          String?
  gstRateName        String?
  gstRatePercent     Decimal?        @db.Decimal(5, 2)
  lineTotal          Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId   String?
  createdAt          DateTime        @default(now())
  purchase           Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product            Product         @relation(fields: [productId], references: [id])
  inventoryStock     InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  metalType          StoreMetal?     @relation(fields: [metalTypeId], references: [id])
  gstRate            GstRate?        @relation(fields: [gstRateId], references: [id])

  @@index([purchaseId])
  @@index([productId])
  @@index([inventoryStockId])
  @@index([gstRateId])
}

model PurityFineness {
  id              String     @id @default(cuid())
  storeId         String
  purity          PurityType
  finenessPercent Decimal    @db.Decimal(5, 2)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  store           Store      @relation(fields: [storeId], references: [id])

  @@unique([storeId, purity])
}

// How many grams one carat is worth, per purity — the store-configurable
// counterpart to the app-wide GRAMS_PER_CARAT default (0.2g, the real
// diamond-carat standard) in lib/purity.ts. Same shape/role as
// PurityFineness above (one row per PurityType, lazily seeded with
// defaults on first read — see getGramsPerCaratMap), just a different
// number: this converts a Carat Weight into grams (Product/Stock/
// Invoice/Purchase/Kacha/Quotation's Carat Weight <-> Net Weight fields),
// fineness converts a weight into its fine-metal content.
model CaratConversionRate {
  id            String     @id @default(cuid())
  storeId       String
  purity        PurityType
  gramsPerCarat Decimal    @db.Decimal(6, 4)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  store         Store      @relation(fields: [storeId], references: [id])

  @@unique([storeId, purity])
}

// A store-configured selling price per metal karat/fineness — Settings >
// Purity's "Metal Selling Rates" grid. Unlike CaratConversionRate/
// PurityFineness above, this is NOT lazily seeded with a default on first
// read: an unconfigured purity has no meaningful universal price, so it
// stays absent (no row) and callers fall back to StoreMetal.sellingPrice
// instead. Only covers the karat/fineness purities (Gold/Silver/Platinum
// variants) — Diamond and other gemstones are priced per stone type via
// StoreMetal.sellingPrice directly, since they have no karat concept.
model MetalSellingRate {
  id           String     @id @default(cuid())
  storeId      String
  purity       PurityType
  sellingPrice Decimal    @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  store        Store      @relation(fields: [storeId], references: [id])

  @@unique([storeId, purity])
}

/**
 * A store-managed, reusable GST rate — Settings > GST Rates (Add/Edit/
 * Activate/Deactivate). Replaces the old single BusinessSettings.
 * defaultGstRate flat number: a store can now define as many rates as it
 * needs (e.g. "Metal" 3%, "Making Charges" 18%, "Artisan Services" 18%,
 * plus any custom one), picked from a dropdown wherever a GST % is chosen.
 * `name` is the label shown in that dropdown.
 * Invoice picks this PER LINE ITEM (InvoiceItem.gstRateId) — a single
 * invoice can genuinely mix e.g. a 3% metal line with an 18% making-charge
 * line, so the rate lives on the line, not the document. Invoice's own
 * gstRateId/gstRateName/gstRatePercent trio is legacy from before this:
 * still populated (as the invoice's own default-for-new-lines pick) for
 * backward compatibility with rows saved before per-line rates existed,
 * but no longer the source of truth for what any given line actually
 * charged — read InvoiceItem's own trio for that. Purchase and Quotation
 * still pick one rate for the whole document (their own gstRateId trio,
 * unchanged) — only Invoice has gone per-line so far.
 * This is the GST *rate* only — GstScheme (REGULAR_B2C/REGULAR_B2B/
 * COMPOSITION, on BusinessSettings) and the SGST/CGST/IGST split
 * (computeGst() in lib/gst.ts, driven by store vs. counterparty state)
 * are separate, unrelated concerns and stay exactly as they are.
 * Deactivating (isActive=false) removes a rate from the picker for NEW
 * lines/documents without touching any that already used it — every
 * gstRateId/gstRatePercent/gstRateName trio (Invoice, InvoiceItem,
 * Purchase, Quotation) is a snapshot of the rate actually applied at the
 * time, so a later change or deactivation here never rewrites history.
 * `isDefault` (at most one true per store, enforced in application code,
 * not a DB constraint) is which rate a brand-new document/line preselects.
 */
model GstRate {
  id            String         @id @default(cuid())
  storeId       String
  name          String
  ratePercent   Decimal        @db.Decimal(5, 2)
  isActive      Boolean        @default(true)
  isDefault     Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  store         Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoices      Invoice[]
  invoiceItems  InvoiceItem[]
  purchases     Purchase[]
  purchaseItems PurchaseItem[]
  quotations    Quotation[]

  @@unique([storeId, name])
  @@index([storeId])
}

model KarigarReceiptItem {
  id               String          @id @default(cuid())
  karigarJobId     String
  itemName         String
  productId        String?
  metalTypeId      String?
  purity           PurityType
  quantity         Int             @default(1)
  grossWeight      Decimal?        @db.Decimal(12, 5)
  netWeight        Decimal?        @db.Decimal(12, 5)
  stoneWeight      Decimal?        @db.Decimal(12, 5)
  dmoWeight        Decimal?        @db.Decimal(12, 5)
  wastagePercent   Decimal?        @db.Decimal(5, 2)
  fineWeight       Decimal         @db.Decimal(12, 5)
  inventoryStockId String?
  createdAt        DateTime        @default(now())
  karigarJob       KarigarJob      @relation(fields: [karigarJobId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id])
  inventoryStock   InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  metalType        StoreMetal?     @relation(fields: [metalTypeId], references: [id])
  // Back-relation for DraftOrderItem.karigarReceiptItemId — the FK lives on
  // DraftOrderItem, set once this specific receipt fulfils an order's item.
  draftOrderItem   DraftOrderItem?

  @@index([karigarJobId])
  @@index([productId])
  @@index([inventoryStockId])
}

// A phone/counter order captured before the physical piece exists — staff
// record the customer + what they want (DraftOrderItem, below), send it to
// a Karigar for manufacturing (sets karigarJobId), and once every item is
// matched to what the Karigar actually returned, this flips to RECEIVED.
// Deliberately one Draft Order <-> at most one KarigarJob (karigarJobId is
// unique): pooling several orders' metal into one job, or splitting one
// order across multiple jobs, is out of scope for this pass.
model DraftOrder {
  id            String    @id @default(cuid())
  storeId       String
  orderNumber   String
  customerId    String
  orderDate     DateTime  @default(now())
  expectedDate  DateTime?
  // DRAFT (just created) -> SENT_TO_KARIGAR (job created) -> RECEIVED
  // (every item matched to a KarigarReceiptItem) -> CANCELLED (only ever
  // reachable from DRAFT). Plain String, same convention as
  // KarigarJob.status/Quotation.status.
  status        String    @default("DRAFT")
  karigarJobId  String?   @unique
  locationId    String?
  notes         String?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  store      Store            @relation(fields: [storeId], references: [id])
  customer   Customer         @relation(fields: [customerId], references: [id])
  karigarJob KarigarJob?      @relation(fields: [karigarJobId], references: [id])
  location   StoreLocation?   @relation(fields: [locationId], references: [id])
  items      DraftOrderItem[]

  @@unique([storeId, orderNumber])
  @@index([storeId, status])
  @@index([customerId])
}

// One requested piece on a DraftOrder. estimatedWeight/estimatedRate are the
// staff's rough figures at order time, not what's actually produced — the
// real weight/rate lands on the linked KarigarReceiptItem/InventoryStock
// once received (see karigarReceiptItemId below).
model DraftOrderItem {
  id                   String      @id @default(cuid())
  draftOrderId         String
  itemName             String
  metalTypeId          String?
  purity               PurityType?
  quantity             Int         @default(1)
  estimatedWeight      Decimal?    @db.Decimal(12, 5)
  estimatedRate        Decimal?    @db.Decimal(12, 2)
  designNotes          String?
  // Set once this specific piece is received — the single source of truth
  // for "has this item been fulfilled," and how its Product/InventoryStock
  // are looked up (via karigarReceiptItem.productId/inventoryStockId)
  // rather than duplicating those FKs here.
  karigarReceiptItemId String?     @unique
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  draftOrder         DraftOrder          @relation(fields: [draftOrderId], references: [id], onDelete: Cascade)
  metalType          StoreMetal?         @relation(fields: [metalTypeId], references: [id])
  karigarReceiptItem KarigarReceiptItem? @relation(fields: [karigarReceiptItemId], references: [id])

  @@index([draftOrderId])
}

model Quotation {
  id              String          @id @default(cuid())
  storeId         String
  quotationNumber String
  customerId      String
  quotationDate   DateTime        @default(now())
  validUntil      DateTime?
  status          String          @default("open")
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  makingCharges   Decimal         @default(0) @db.Decimal(12, 2)
  stoneCharges    Decimal         @default(0) @db.Decimal(12, 2)
  discount        Decimal         @default(0) @db.Decimal(12, 2)
  // taxAmount stays as the persisted sgst+cgst+igst total - every existing
  // read of it (totals, exports, the print template) keeps working
  // unchanged. The three below are new: Quotation never broke tax into
  // components before, matching how it never did per-line tax at all
  // (unlike Invoice/InvoiceItem) - this stays at the document level for the
  // same reason, not per QuotationItem.
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount      Decimal         @default(0) @db.Decimal(12, 2)
  cgstAmount      Decimal         @default(0) @db.Decimal(12, 2)
  igstAmount      Decimal         @default(0) @db.Decimal(12, 2)
  // Which configured GstRate (Settings > GST Rates) was picked, snapshotted
  // at the time — see GstRate's own doc comment. Nullable: a quotation
  // raised before this field existed has none.
  gstRateId       String?
  gstRateName     String?
  gstRatePercent  Decimal?        @db.Decimal(5, 2)
  // See Invoice.roundOffAmount's own doc comment — same convention.
  roundOffAmount  Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  notes           String?
  convertedToId   String?         @unique
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  store           Store           @relation(fields: [storeId], references: [id])
  customer        Customer        @relation(fields: [customerId], references: [id])
  gstRate         GstRate?        @relation(fields: [gstRateId], references: [id])
  convertedTo     Invoice?        @relation("QuotationConvertedToInvoice", fields: [convertedToId], references: [id])
  items           QuotationItem[]
  locationId      String?
  location        StoreLocation?  @relation(fields: [locationId], references: [id])

  @@unique([storeId, quotationNumber])
  @@index([customerId])
  @@index([quotationDate])
  @@index([storeId])
  @@index([locationId])
}

model QuotationItem {
  id                 String          @id @default(cuid())
  quotationId        String
  itemName           String
  metalTypeId        String?
  purity             PurityType?
  quantity           Int             @default(1)
  grossWeight        Decimal?        @db.Decimal(12, 5)
  netWeight          Decimal?        @db.Decimal(12, 5)
  stoneWeight        Decimal?        @db.Decimal(12, 5)
  caratWeight        Decimal?        @db.Decimal(10, 3)
  rate               Decimal?        @db.Decimal(12, 2)
  makingCharge       Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType   ChargeType      @default(FIXED)
  // Hallmarking charge, folded into the quotation's Making Charges total —
  // same convention as InvoiceItem.hmCharge's own doc comment.
  hmCharge           Decimal         @default(0) @db.Decimal(12, 2)
  stoneCharge        Decimal         @default(0) @db.Decimal(12, 2)
  stoneRate          Decimal?        @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName String?
  stoneTypeNames     String?
  lineTotal          Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId   String?
  quotation          Quotation       @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  inventoryStock     InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  metalType          StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([quotationId])
  @@index([inventoryStockId])
}

model State {
  id        String   @id @default(cuid())
  name      String   @unique
  isoCode   String   @unique
  country   String   @default("India")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cities    City[]
}

model City {
  id        String   @id @default(cuid())
  name      String
  stateId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  state     State    @relation(fields: [stateId], references: [id], onDelete: Cascade)

  @@unique([name, stateId])
  @@index([stateId])
}

model MetalRate {
  id         String   @id @default(cuid())
  storeId    String
  gold22k    Decimal  @db.Decimal(12, 2)
  gold24k    Decimal  @db.Decimal(12, 2)
  gold18k    Decimal  @db.Decimal(12, 2)
  gold14k    Decimal? @db.Decimal(12, 2)
  silver     Decimal  @db.Decimal(12, 2)
  // 95%-purity platinum rate, matching the "Standard Rate" banner some
  // stores print on the invoice. Optional: not every store deals in
  // platinum, and a missing rate simply drops that column from the banner.
  platinum95 Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  unit       String   @default("GRAM")
  store      Store    @relation(fields: [storeId], references: [id])

  @@index([createdAt])
  @@index([storeId])
}

model BusinessSettings {
  storeId String @id
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // Business identity
  businessName String
  legalName    String?
  logoUrl      String?

  // Tax / compliance
  gstNumber String?
  panNumber String?
  cin       String? // Corporate Identification Number, for registered companies
  stateCode String? // GST state code, e.g. "27" for Maharashtra

  // Which of the three GST registration types this store operates under.
  // Drives what's shown/required across Billing, Quotations, and Purchases -
  // see GstScheme's own doc comment. Defaults to REGULAR_B2C so every
  // existing store (created before this field existed) keeps behaving
  // exactly as it already did: full SGST/CGST charged, customer GSTIN
  // optional - a Composition or B2B store has to explicitly opt in here.
  gstScheme GstScheme @default(REGULAR_B2C)

  // Contact & address
  address String?
  city    String?
  state   String?
  pincode String?
  phone   String?
  email   String?
  website String?

  // Where destructive bulk operations send their backup before deleting
  // anything. Kept separate from `email` above (the store's public contact
  // address) so a backup can be routed to an owner/accountant inbox.
  backupEmail String?

  // Invoice preferences
  invoicePrefix     String     @default("INV")
  invoiceStartingNo Int        @default(1)
  invoiceTerms      String?
  invoiceNotes      String?
  // Which print layout the Invoice print page renders — see PrintLayout's
  // own doc comment. A store-wide default; not per-invoice.
  printLayout       PrintLayout    @default(A4)
  // Which of the four professionally-designed A4 templates to render when
  // printLayout is A4 — see InvoiceTemplate's own doc comment. Ignored when
  // printLayout is THERMAL (that format has no template variants).
  invoiceTemplate   InvoiceTemplate @default(CLASSIC)

  // Bank account the store gets paid into — printed as the invoice's "Pay
  // To" block. All optional and independent of each other: the print page
  // shows the block only once bankName is set, same "don't show a
  // half-filled section" convention as settings.logoUrl.
  bankName              String?
  bankAccountNumber     String?
  bankIfscCode          String?
  bankAccountHolderName String?

  // Which SKU layout preset createProduct's generator uses for every new
  // product's productCode — see SkuFormat's own doc comment. Defaults to
  // the layout the SKU feature originally shipped with, so no existing
  // store's behavior changes until an Admin picks a different preset in
  // Settings.
  skuFormat SkuFormat @default(METAL_PURITY_STYLE_CATEGORY)

  // Tax defaults
  defaultGstRate Float @default(3.0) // jewellery GST is typically 3%

  // BIS hallmarking fee, charged as a flat ₹ amount per hallmarked piece
  // (not a % or per-gram charge — that's how the Assaying & Hallmarking
  // Centre actually bills a jewellery store) on every Gold/Silver line item
  // across Invoice/Kacha Slip/Quotation — see isHallmarkablePurity() in
  // lib/purity.ts for exactly which PurityType values qualify (Platinum/
  // Diamond/Other never get this). The ₹45 default is a PLACEHOLDER, same
  // spirit as this codebase's other "needs real-world verification before
  // trusting it" numbers (e.g. a payment-threshold placeholder elsewhere
  // in this app) — BIS hallmarking rates change periodically via official
  // notification, and this was never confirmed against a specific store's
  // current hallmarking-centre invoice. Settings UI must tell the store to
  // verify/correct this figure, not present it as an authoritative rate.
  hallmarkChargePerPiece Decimal @default(45) @db.Decimal(12, 2)

  // Whether the return window policy is active at all — a store can turn
  // returns off entirely without losing whatever returnWindowDays it had
  // configured (re-enabling later restores the same day count, rather than
  // the old "set days to 0" convention that couldn't distinguish "always
  // ineligible" from "policy not offered"). Every consumer of
  // returnWindowDays (invoice detail page, customer ledger's Refund/Replace
  // pickers, createCreditNote's server-side gate) checks this alongside the
  // day count.
  returnWindowEnabled Boolean @default(true)
  // How many days after invoiceDate a sold item may still be returned via a
  // Credit Note — see CreditNote and lib/actions/credit-note-actions.ts'
  // isReturnEligible(). A store-wide figure (not per-product/category) by
  // design: this is a policy the whole store states to every customer, not
  // a per-item attribute. Only enforced when returnWindowEnabled is true.
  returnWindowDays    Int     @default(30)

  // Financial year
  financialYearStartMonth Int @default(4) // April = 4, common in India

  // Which unit(s) this business transacts and settles balances in.
  // Drives how the ledger (general + per-customer) totals/entries are denominated.
  // Each entry is either the literal sentinel "MONEY" (always available, not
  // a real row anywhere) or a live StoreMetal.id — covering both plain
  // metals and gemstones (StoreMetal.isGemstone), since a store's actual set
  // of settlement units is whatever it has configured in Taxonomy, not a
  // fixed Gold/Silver/Diamond list. Used to be BusinessUnit[] (a fixed
  // Postgres enum) — see the dynamic-business-units migration for the
  // one-time backfill from that enum to StoreMetal ids. Resolve this via
  // getActiveBusinessUnits()/getAvailableBusinessUnitOptions()
  // (lib/business-units.server.ts), never read raw.
  businessUnits String[] @default(["MONEY"])

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/**
 * Swarna Suite's own Contact Us content — platform-wide, not per-store.
 * Deliberately has NO storeId, unlike almost every other model in this
 * schema. This is the platform operator's support info (message, optional
 * image, contact details) shown identically to every store's users and
 * every public-site visitor — not a per-tenant setting like
 * BusinessSettings above. This is a correct, intentional exception to the
 * storeId-scoping convention, not an oversight — do not add storeId here.
 * A singleton: the service layer fetches the first row (creating a default
 * one on first access, same pattern as getBusinessSettings) rather than
 * looking up by a caller-supplied id. Editable only by SUPER_ADMIN — see
 * lib/actions/platform-content-actions.ts.
 */
model PlatformContactContent {
  id      String @id @default(cuid())
  // Editable multi-line message shown on the public Contact Us page and in
  // the app's Help & Support section. Plain text, not rich text/HTML — see
  // the doc comment on ContactContentForm for why.
  message String

  // Optional supporting image (e.g. a support-desk photo, a QR code to a
  // WhatsApp line). Uploaded via Vercel Blob, same convention as
  // BusinessSettings.logoUrl / app/api/store/logo/route.ts.
  imageUrl String?

  email   String?
  phone   String?
  address String?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/**
 * A single FAQ question/answer pair, platform-wide (no storeId — same
 * reasoning as PlatformContactContent above). `position` drives manual
 * ordering in the SUPER_ADMIN editor; `isPublished` lets a draft entry be
 * prepared before it appears on the public FAQ page / app Help section.
 */
model PlatformFaq {
  id          String  @id @default(cuid())
  question    String
  answer      String
  position    Int     @default(0)
  isPublished Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([isPublished, position])
}

/**
 * A ticket's lifecycle, set by SUPER_ADMIN (see SupportTicket.status):
 * OPEN        - Just submitted (or reopened by a submitter reply after
 * RESOLVED/CLOSED), awaiting a first/next look.
 * IN_PROGRESS - A Super Admin has replied and is actively working it.
 * Set automatically on a Super Admin reply to an OPEN
 * ticket, and settable by hand too.
 * RESOLVED    - The Super Admin considers the issue addressed. Still
 * replyable — a submitter who isn't satisfied replying
 * flips it back to OPEN (see replyToSupportTicket).
 * CLOSED      - Terminal from the Super Admin's side (e.g. a duplicate,
 * or no response after resolution). A submitter reply still
 * reopens it to OPEN, same as RESOLVED — a two-way thread
 * that couldn't be reopened by the person it's about would
 * defeat the point of building it two-way at all.
 */
enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

/**
 * A support ticket raised through the Contact Us form — either the public,
 * unauthenticated site (app/contact/page.tsx) or the authenticated app's own
 * Contact & FAQ page (app/(dashboard)/contact-faq/page.tsx). Platform
 * support, not a per-store record: every ticket is visible to every
 * SUPER_ADMIN regardless of which store (if any) it came from, which is why
 * `storeId` is optional rather than the mandatory scoping field almost every
 * other model in this schema carries.
 * `submittedById` is null for an anonymous public-site visitor (no account
 * to attribute it to); `submitterName`/`submitterEmail`/`submitterPhone` are
 * always captured as plain-text snapshots — even for a signed-in submitter
 * — so the ticket keeps saying who to reach and how, unaffected by a later
 * profile edit or the account being removed. Email and phone are both
 * required at submission (enforced in submitSupportTicket*, not just the
 * form's `required` attribute) so a Super Admin always has two independent
 * ways to reach back out.
 * The first message in the thread (the submission itself) is the first row
 * in `messages`, not a field on this model — everything after it, from
 * either side, is just another SupportTicketMessage row. `lastMessageAt` is
 * a denormalized copy of the latest message's `createdAt`, kept here purely
 * so the Super Admin inbox can sort/filter by recent activity with a single
 * indexed column instead of an aggregate subquery per row.
 * `ticketNumber` is a human-readable, platform-wide identifier
 * (`TKT-{YYYYMMDD}-{HHMM}-{padded daily sequence}`, e.g.
 * `TKT-20260903-1745-0003`) assigned at creation — same idea as
 * Invoice.invoiceNumber's own `{prefix}-{YYYYMMDD}-{padded daily sequence}`
 * (see generateInvoiceNumber in lib/actions/invoice-actions.ts), except
 * this one also encodes the time, since Purchase/Quotation/KachaInvoice
 * still use the older `{prefix}-{year}-{padded count}` shape (see each
 * one's own `generate*Number` in lib/actions/*.ts) — a ticket's own
 * date/time is encoded directly into the number so it's readable at a
 * glance without opening it. Counted across
 * every store rather than scoped to one, since a ticket itself is
 * platform-wide, not a per-store record (see storeId above). Shown to both
 * the submitter and the Super Admin, and threaded into the ticket's emails
 * via an identical `[TKT-...]` subject prefix on every notification for it.
 */
model SupportTicket {
  id             String                 @id @default(cuid())
  ticketNumber   String                 @unique
  subject        String
  status         TicketStatus           @default(OPEN)
  storeId        String?
  submittedById  String?
  submitterName  String
  submitterEmail String
  submitterPhone String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lastMessageAt  DateTime               @default(now())
  store          Store?                 @relation(fields: [storeId], references: [id])
  submittedBy    User?                  @relation("SupportTicketSubmittedBy", fields: [submittedById], references: [id])
  messages       SupportTicketMessage[]

  @@index([storeId])
  @@index([submittedById])
  @@index([status])
  @@index([lastMessageAt])
}

/**
 * One message in a SupportTicket's thread — the original submission and
 * every reply after it, from either side, are all rows here (see
 * SupportTicket's own doc comment for why the first message isn't a field
 * on the ticket itself).
 * `authorId` is null for an anonymous public submission (no account) and
 * for a Super Admin reply if that's ever sent by something other than a
 * logged-in User row (it never is today, but the snapshot fields make that
 * safe either way); `authorName` is always a plain-text snapshot, same
 * reasoning as SupportTicket's submitter fields. `isFromSuperAdmin` is the
 * one flag the thread UI actually branches on to align a bubble left/right
 * — deliberately not inferred from `authorId`/role at render time, since a
 * Super Admin's own role could change after the fact and the message should
 * keep showing which side of the conversation it was actually sent from.
 */
model SupportTicketMessage {
  id                 String        @id @default(cuid())
  ticketId           String
  authorId           String?
  authorName         String
  isFromSuperAdmin   Boolean       @default(false)
  body               String
  // At most one attachment per message (no separate Attachment/Media model
  // anywhere in this schema — same single-nullable-field convention as
  // LedgerEntry.attachmentUrl). All four are optional and only ever set
  // together, populated after a direct-to-browser Vercel Blob client
  // upload completes (see app/api/support-tickets/upload/route.ts) —
  // attachmentName preserves the original filename for display since the
  // blob's own pathname gets a random suffix.
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  attachmentSize     Int?
  createdAt          DateTime      @default(now())
  ticket             SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author             User?         @relation("SupportTicketMessageAuthor", fields: [authorId], references: [id])

  @@index([ticketId])
  @@index([authorId])
}

model User {
  id                    String                     @id @default(cuid())
  name                  String?
  email                 String?                    @unique
  phone                 String?                    @unique
  image                 String?
  panNumber             String?
  role                  UserRole                   @default(STAFF)
  status                UserStatus                 @default(INVITED)
  isActive              Boolean                    @default(true)
  emailVerified         DateTime?
  phoneVerified         DateTime?
  invitedById           String?
  storeId               String?
  karigarId             String?                    @unique
  permissions           String[]                   @default([])
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  addressLine1          String?
  addressLine2          String?
  city                  String?
  country               String?                    @default("India")
  pincode               String?
  state                 String?
  // Optional KYC id — validated (12 digits + Verhoeff checksum, see
  // lib/aadhaar.ts) only when actually entered.
  aadhaarNumber         String?
  accounts              Account[]
  employee              Employee?
  store                 Store?                     @relation(fields: [storeId], references: [id])
  storeMemberships      UserStoreMembership[]
  karigar               Karigar?                   @relation(fields: [karigarId], references: [id])
  createdInviteTokens   InviteToken[]              @relation("UserCreatedInvites")
  inviteTokens          InviteToken[]              @relation("InviteTokenUser")
  otpCodes              OtpCode[]
  sessions              Session[]
  invitedBy             User?                      @relation("UserInvites", fields: [invitedById], references: [id])
  invitedUsers          User[]                     @relation("UserInvites")
  locationAccess        UserLocationAccess[]
  scanSessions          ScanSession[]
  invoicesCreated       Invoice[]                  @relation("InvoiceCreatedBy")
  invoicesCancelled     Invoice[]                  @relation("InvoiceCancelledBy")
  apiKeysCreated        ApiKey[]                   @relation("ApiKeyCreatedBy")
  customersCreated      Customer[]                 @relation("CustomerCreatedBy")
  supportTicketsFiled   SupportTicket[]            @relation("SupportTicketSubmittedBy")
  supportTicketMessages SupportTicketMessage[]     @relation("SupportTicketMessageAuthor")
  inventoryStocksAdded  InventoryStock[]           @relation("InventoryStockCreatedBy")
  purchasesRecorded     Purchase[]                 @relation("PurchaseCreatedBy")
  creditNotesCreated    CreditNote[]               @relation("CreditNoteCreatedBy")
  remindersCreated      Reminder[]                 @relation("ReminderCreatedBy")
  ledgerEntriesCreated  LedgerEntry[]              @relation("LedgerEntryCreatedBy")
  // Only ever populated for a SUPER_ADMIN — which stores they've redeemed a
  // Collaboration Code for. See StoreCollaborationAccess.
  collaborationAccess   StoreCollaborationAccess[]
  accessRequestsMade    StoreAccessRequest[]       @relation("StoreAccessRequestedBy")
  accessRequestsHandled StoreAccessRequest[]       @relation("StoreAccessRequestRespondedBy")

  @@index([storeId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model InviteToken {
  id          String    @id @default(cuid())
  email       String?
  phone       String?
  tokenHash   String    @unique
  role        UserRole
  name        String?
  storeId     String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  userId      String?
  invitedById String
  createdAt   DateTime  @default(now())
  store       Store?    @relation(fields: [storeId], references: [id])
  invitedBy   User      @relation("UserCreatedInvites", fields: [invitedById], references: [id], onDelete: Cascade)
  user        User?     @relation("InviteTokenUser", fields: [userId], references: [id])

  @@index([email])
  @@index([phone])
  @@index([invitedById])
  @@index([storeId])
}

// A credential for programmatic access (a future mobile app, an AI
// assistant via MCP) — store-scoped like everything else in this app, never
// stores the raw secret (only its sha256, same convention as
// InviteToken.tokenHash), and carries its own permission list rather than
// inheriting whatever the creating Admin can do, so a leaked key has a
// bounded blast radius.
model ApiKey {
  id          String    @id @default(cuid())
  storeId     String
  name        String
  // First chars of the raw key, stored in plaintext purely so the Settings
  // list can show "sk_live_a1b2..." for identification — never enough to
  // reconstruct the real secret.
  prefix      String
  keyHash     String    @unique
  permissions String[]  @default([])
  isRevoked   Boolean   @default(false)
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  store       Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ApiKeyCreatedBy", fields: [createdById], references: [id])

  @@index([storeId])
  @@index([createdById])
}

model OtpCode {
  id         String     @id @default(cuid())
  phone      String?
  email      String?
  codeHash   String
  purpose    OtpPurpose
  expiresAt  DateTime
  consumedAt DateTime?
  userId     String?
  createdAt  DateTime   @default(now())
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone, purpose])
  @@index([email, purpose])
  @@index([userId])
}

model Employee {
  id           String    @id @default(cuid())
  employeeCode String    @unique
  userId       String    @unique
  designation  String?
  branch       String?
  joiningDate  DateTime?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}


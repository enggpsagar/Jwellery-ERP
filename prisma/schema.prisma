generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Store {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  city      String?
  state     String?
  pincode   String?
  phone     String?
  email     String?
  gstNumber String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  planId             String?
  plan               Plan?     @relation(fields: [planId], references: [id])
  planStartedAt      DateTime?
  planExpiresAt      DateTime?
  planReminderSentAt DateTime?

  /**
   * When the owner was last told this store is archived. Every blocked
   * sign-in would otherwise send another email, so ten retries would mean
   * ten identical messages. Cleared on restore, so a store archived again
   * later notifies again.
   */
  archiveNotifiedAt DateTime?

  /**
   * Which channels this store's owner accepts renewal reminders on.
   * Email is wired up (app/api/cron/plan-reminders). WhatsApp is a stored
   * preference only — there is no WhatsApp sender in this codebase yet, so
   * the flag records intent and the UI says so rather than implying reminders
   * are going out on a channel nothing delivers to.
   */
  reminderEmailEnabled    Boolean @default(true)
  reminderWhatsappEnabled Boolean @default(false)

  users                User[]
  userMemberships      UserStoreMembership[]
  planHistory          StorePlanHistory[]
  scanSessions         ScanSession[]
  customers            Customer[]
  karigars             Karigar[]
  products             Product[]
  inventoryStock       InventoryStock[]
  invoices             Invoice[]
  kachaInvoices        KachaInvoice[]
  ledgerEntries        LedgerEntry[]
  karigarJobs          KarigarJob[]
  metalRates           MetalRate[]
  businessSettings     BusinessSettings?
  inviteTokens         InviteToken[]
  vendors              Vendor[]
  purchases            Purchase[]
  purityFinenesses     PurityFineness[]
  caratConversionRates CaratConversionRate[]
  quotations           Quotation[]
  storeMetals          StoreMetal[]
  storeCategories      StoreCategory[]
  storeLocations       StoreLocation[]
  apiKeys              ApiKey[]
  supportTickets       SupportTicket[]

  @@index([code])
}

model Plan {
  id           String   @id @default(cuid())
  name         String
  durationDays Int
  price        Decimal  @default(0) @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stores  Store[]
  history StorePlanHistory[]
}

/**
 * How a plan period began.
 */
enum StorePlanAction {
  REGISTERED
  ASSIGNED
  RENEWED
}

/**
 * One row per plan period a store has held — the subscription ledger.
 * Needed because Store.planStartedAt/planExpiresAt are overwritten on every
 * assignment: without this table a renewal destroys the record of the period
 * it replaced, so "last renewal" and "history" cannot be answered at all.
 * planName, price and durationDays are snapshots rather than reads through
 * the relation. A plan can be renamed, repriced or deactivated, and history
 * has to keep saying what was actually sold at the time.
 */
model StorePlanHistory {
  id           String          @id @default(cuid())
  storeId      String
  planId       String?
  planName     String
  price        Decimal         @default(0) @db.Decimal(12, 2)
  durationDays Int
  startedAt    DateTime
  expiresAt    DateTime
  action       StorePlanAction @default(ASSIGNED)
  /**
   * Which Super Admin made the change; null for self-registration.
   */
  actorId      String?
  actorName    String?
  note         String?
  createdAt    DateTime        @default(now())

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  Plan? @relation(fields: [planId], references: [id])

  @@index([storeId])
  @@index([startedAt])
}

model StoreLocation {
  id              String               @id @default(cuid())
  storeId         String
  name            String
  state           String?
  city            String?
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  store           Store                @relation(fields: [storeId], references: [id])
  inventoryStocks InventoryStock[]
  karigars        Karigar[]
  purchases       Purchase[]
  invoices        Invoice[]
  kachaInvoices   KachaInvoice[]
  karigarJobs     KarigarJob[]
  ledgerEntries   LedgerEntry[]
  quotations      Quotation[]
  userAccess      UserLocationAccess[]

  @@unique([storeId, name])
}

/**
 * Grants a Staff user access to one or more locations. Mirrors the
 * User.permissions convention: zero rows for a user means unrestricted
 * (sees every location), same as an empty `permissions` array meaning
 * "not customized" falls back to full module access — the two axes are
 * independent (a module permission and a location grant), but both use
 * the same "empty = unrestricted" rule so they don't have to be reasoned
 * about differently. Only Staff is ever actually restricted — Admin/Super
 * Admin/Karigar are never gated by this table (Karigar's own scoping goes
 * through Karigar.locationId instead, since a User with role KARIGAR is
 * always 1:1 with a Karigar row via User.karigarId).
 */
/**
 * A person's access to one store. Someone who works across several stores
 * has one row per store, each carrying its own role and module permissions.
 * `User` stays globally unique on email and phone and is NOT duplicated per
 * store: the NextAuth Prisma adapter resolves Google sign-in through
 * `findUnique({ where: { email } })`, and OTP login does the same on phone,
 * so a second row for the same person would break authentication outright.
 * One login, many memberships.
 * `User.storeId` / `User.role` / `User.permissions` remain as the default
 * membership for accounts that predate this table, and are what a single-
 * store user still resolves to. Membership rows win when present.
 */
model UserStoreMembership {
  id          String   @id @default(cuid())
  userId      String
  storeId     String
  role        UserRole @default(STAFF)
  permissions String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([userId, storeId])
  @@index([userId])
  @@index([storeId])
}

model UserLocationAccess {
  id         String        @id @default(cuid())
  userId     String
  locationId String
  createdAt  DateTime      @default(now())
  user       User          @relation(fields: [userId], references: [id])
  location   StoreLocation @relation(fields: [locationId], references: [id])

  @@unique([userId, locationId])
  @@index([userId])
  @@index([locationId])
}

model StoreMetal {
  id                  String               @id @default(cuid())
  storeId             String
  name                String
  hasPurity           Boolean              @default(false)
  // True for a gemstone row (Diamond, Ruby, Emerald, Sapphire, ...) managed
  // from Settings' Stones section rather than its Metals section — same
  // table, same metalTypeId FK everywhere, just a second lens onto it (see
  // the origins relation below and the Settings Taxonomy UI). This is now the
  // authoritative signal for "is this row a stone" wherever it's cheap to
  // plumb through (product-form.tsx's classifyPurityFamily); the older
  // name-substring heuristics (classifyMetalName, isCaratWeighedMetal) are
  // left alongside it rather than replaced everywhere they're called, since
  // several of those call sites only ever had a bare metal *name* string to
  // work with (historical ledger entries, purchase/invoice line items) —
  // see the comments on those functions for the reconciliation reasoning.
  isGemstone          Boolean              @default(false)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  store               Store                @relation(fields: [storeId], references: [id])
  products            Product[]
  inventoryStocks     InventoryStock[]
  kachaInvoiceItems   KachaInvoiceItem[]
  invoiceItems        InvoiceItem[]
  ledgerEntries       LedgerEntry[]
  karigarJobs         KarigarJob[]
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  quotationItems      QuotationItem[]
  // Only meaningful when isGemstone is true — the same one-to-many shape as
  // StoreCategory.types below. Replaces the old single nullable
  // StoreMetal.stoneOrigin column: a store dealing in BOTH natural and
  // lab-grown Diamond needs to express both as independently manageable
  // options under the one "Diamond" row, not two separate StoreMetal rows.
  // Free-text since 2026-09 (was a fixed Natural/Lab-Grown enum — see
  // StoreMetalOrigin's own doc comment). See Product.stoneOriginOptionId for
  // how a product picks exactly one.
  origins             StoreMetalOrigin[]

  @@unique([storeId, name])
}

// A single Stone Type option under a gemstone StoreMetal row (Diamond,
// Ruby, ...) — mirrors StoreCategoryType's shape/role under StoreCategory
// exactly, including being free-text (`name`), Store-Admin-managed, not
// restricted to a predefined set. Only ever created for a row with
// isGemstone=true; nothing enforces that at the DB level, same as
// StoreCategoryType not enforcing its parent is any particular kind of
// category — the taxonomy actions gate it instead.
//
// Was a fixed `origin: StoneOrigin` enum (NATURAL/LAB_GROWN only) until
// 2026-09, when it was converted to free text so a Store Admin can add any
// Stone Type they deal in (Natural, Lab-Grown, Moissanite, ...) the same way
// they already add Category Types — see the hand-written migration
// `20260903080000_convert_stone_origin_to_free_text` for the backfill of
// existing NATURAL/LAB_GROWN rows into `name` values.
model StoreMetalOrigin {
  id           String     @id @default(cuid())
  storeId      String
  storeMetalId String
  name         String
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  storeMetal   StoreMetal @relation(fields: [storeMetalId], references: [id], onDelete: Cascade)
  products     Product[]

  @@unique([storeMetalId, name])
}

model StoreCategory {
  id        String              @id @default(cuid())
  storeId   String
  name      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  store     Store               @relation(fields: [storeId], references: [id])
  types     StoreCategoryType[]
  products  Product[]

  @@unique([storeId, name])
}

model StoreCategoryType {
  id         String        @id @default(cuid())
  storeId    String
  categoryId String
  name       String
  isActive   Boolean       @default(true)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  category   StoreCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([categoryId, name])
}

model Customer {
  id             String         @id @default(cuid())
  storeId        String
  customerCode   String?
  name           String
  phone          String?
  alternatePhone String?
  email          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  pincode        String?
  gstin          String?
  // This customer's OWN GST registration status — independent of the
  // store's own gstScheme. See PartyGstType's doc comment: it only ever
  // affects whether GSTIN is required/shown here, never how much GST the
  // store itself charges (that's fixed by BusinessSettings.gstScheme).
  // Defaults new records to whatever the store's own gstScheme suggests is
  // more likely, but is freely editable per customer afterward. See
  // gstinRequired() in lib/gst.ts.
  gstType        PartyGstType   @default(UNREGISTERED)
  panNumber      String?
  // A customer-facing loyalty/scheme reference number some stores print on
  // the invoice (e.g. "Encircle Id") — opaque to the app, shown as-is.
  registrationId String?
  notes          String?
  openingBalance Decimal        @default(0) @db.Decimal(12, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isArchived     Boolean        @default(false)
  // Who created this record — the id is the link, the name a snapshot, same
  // convention as Invoice.createdById/createdByName. Nullable: customers
  // created before this was tracked genuinely have no answer, and an
  // API/MCP-created customer has no human User behind it at all.
  createdById    String?
  createdByName  String?
  createdBy      User?          @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  store          Store          @relation(fields: [storeId], references: [id])
  invoices       Invoice[]
  kachaInvoices  KachaInvoice[]
  ledgerEntries  LedgerEntry[]
  quotations     Quotation[]

  @@unique([storeId, customerCode])
  @@unique([storeId, phone])
  @@index([name])
  @@index([phone])
  @@index([customerCode])
  @@index([storeId])
  @@index([createdById])
}

model Karigar {
  id             String         @id @default(cuid())
  storeId        String
  code           String?
  name           String
  mobile         String?
  whatsapp       String?
  email          String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  gstNumber      String?
  panNumber      String?
  aadhaarNumber  String?
  specialization String?
  notes          String?
  openingGold    Decimal        @default(0) @db.Decimal(12, 5)
  openingCash    Decimal        @default(0) @db.Decimal(12, 2)
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  store          Store          @relation(fields: [storeId], references: [id])
  karigarJobs    KarigarJob[]
  ledgerEntries  LedgerEntry[]
  loginUser      User?
  locationId     String?
  location       StoreLocation? @relation(fields: [locationId], references: [id])

  @@unique([storeId, code])
  @@index([name])
  @@index([mobile])
  @@index([code])
  @@index([locationId])
  @@index([storeId])
}

model Product {
  id                        String               @id @default(cuid())
  storeId                   String
  productCode               String
  name                      String
  categoryId                String?
  categoryTypeId            String?
  metalTypeId               String?
  // Only meaningful when metalType.isGemstone is true — mirrors
  // categoryTypeId's role exactly: metalTypeId stays the stone selector
  // (Diamond, Ruby, ...), this is the finer-grained pick of which of that
  // stone's Store-Admin-defined Stone Type options (Natural, Lab-Grown,
  // Moissanite, or whatever else the store has added — see
  // StoreMetalOrigin) this product is.
  stoneOriginOptionId       String?
  defaultPurity             PurityType?
  defaultMakingCharge       Decimal?             @db.Decimal(12, 2)
  defaultMakingChargeType   ChargeType           @default(FIXED)
  defaultStoneCharge        Decimal?             @db.Decimal(12, 2)
  defaultStoneChargeType    ChargeType           @default(FIXED)
  // Typical weights for this design, used to prefill a stock entry rather
  // than to describe any one piece — two rings off the same design are never
  // identical to the milligram, so the per-piece truth stays on
  // InventoryStock. Same Decimal(12, 5) as the columns they seed.
  defaultGrossWeight        Decimal?             @db.Decimal(12, 5)
  defaultNetWeight          Decimal?             @db.Decimal(12, 5)
  defaultStoneWeight        Decimal?             @db.Decimal(12, 5)
  defaultCaratWeight        Decimal?             @db.Decimal(10, 3)
  // A composite piece — one metal (priced by weight, unchanged) plus one
  // embedded stone/diamond component (priced by defaultStoneRate × the
  // existing defaultCaratWeight above, auto-summed into Stone Charge)
  // rather than a flat manually-typed Stone Charge. Distinct from a line
  // whose own metal IS Diamond/Stone (isCaratWeighedMetal) — that's a
  // single carat-priced item, not a metal+stone combination.
  hasStoneComponent         Boolean              @default(false)
  defaultStoneRate          Decimal?             @db.Decimal(12, 2)
  // Which Stone (a StoreMetal row, e.g. "Diamond") and which of its Stone
  // Type options (StoreMetalOrigin rows, e.g. "Natural, Lab-Grown" — comma
  // joined, several may apply to one embedded stone) — plain denormalized
  // names rather than FKs, same convention as vendorName/createdByName
  // elsewhere: this is a descriptive label on the line, not something
  // queried/joined on, so a real relation (times six tables) would be
  // more machinery than the data warrants. Only meaningful alongside
  // hasStoneComponent.
  defaultStoneMetalTypeName String?
  defaultStoneTypeNames     String?
  designCode                String?
  hsnCode                   String?
  description               String?
  notes                     String?
  isActive                  Boolean              @default(true)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  store                     Store                @relation(fields: [storeId], references: [id])
  stockItems                InventoryStock[]
  purchaseItems             PurchaseItem[]
  karigarReceiptItems       KarigarReceiptItem[]
  category                  StoreCategory?       @relation(fields: [categoryId], references: [id])
  categoryType              StoreCategoryType?   @relation(fields: [categoryTypeId], references: [id])
  metalType                 StoreMetal?          @relation(fields: [metalTypeId], references: [id])
  stoneOriginOption         StoreMetalOrigin?    @relation(fields: [stoneOriginOptionId], references: [id])

  @@unique([storeId, productCode])
  @@index([categoryId])
  @@index([categoryTypeId])
  @@index([metalTypeId])
  @@index([stoneOriginOptionId])
  @@index([name])
  @@index([productCode])
  @@index([designCode])
  @@index([storeId])
}

model InventoryStock {
  id                  String                 @id @default(cuid())
  storeId             String
  stockCode           String
  tagNumber           String?
  productId           String
  metalTypeId         String?
  purity              PurityType?
  quantity            Int                    @default(1)
  status              InventoryStockStatus   @default(IN_STOCK)
  finish              InventoryFinish        @default(KACHA)
  isActive            Boolean                @default(true)
  grossWeight         Decimal?               @db.Decimal(12, 5)
  lessWeight          Decimal?               @db.Decimal(12, 5)
  netWeight           Decimal?               @db.Decimal(12, 5)
  stoneWeight         Decimal?               @db.Decimal(12, 5)
  dmoWeight           Decimal?               @db.Decimal(12, 5)
  // Diamond weight in carats — a distinct unit from every gram-based weight
  // above, only meaningful when purity is DIAMOND. Rate then prices per
  // carat, not per gram (see toLineQuantity in the *-actions.ts files).
  caratWeight         Decimal?               @db.Decimal(10, 3)
  wastagePercent      Decimal?               @db.Decimal(5, 2)
  purchaseRate        Decimal?               @db.Decimal(12, 2)
  saleRate            Decimal?               @db.Decimal(12, 2)
  makingCharge        Decimal?               @db.Decimal(12, 2)
  makingChargeType    ChargeType             @default(FIXED)
  stoneCharge         Decimal?               @db.Decimal(12, 2)
  // Rate per carat for this piece's embedded stone/diamond (composite
  // items — metal priced by weight as usual, stone priced by
  // stoneRate × caratWeight, summed into stoneCharge). No boolean flag
  // needed at the stock level — a non-null caratWeight/stoneRate here is
  // signal enough.
  stoneRate           Decimal?               @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName  String?
  stoneTypeNames      String?
  otherCharge         Decimal?               @db.Decimal(12, 2)
  purchaseAmount      Decimal?               @db.Decimal(12, 2)
  saleAmount          Decimal?               @db.Decimal(12, 2)
  vendorName          String?
  purchaseDate        DateTime?
  manufactureDate     DateTime?
  locationId          String?
  remarks             String?
  // Who manually added this stock row — only meaningful for a manual add
  // (see createInventoryStock's own comment: "no vendor/karigar
  // counterparty"). A row created from a Purchase or a karigar job's
  // receipt is instead attributed via that Purchase's own createdBy or the
  // karigarJobs relation below — see getItemLedgerReport's addedByLabel()
  // for the priority order. Name/role are durable snapshots (same
  // convention as Invoice.createdByName) since a user can be renamed,
  // promoted, or deleted after adding this item.
  createdById         String?
  createdByName       String?
  createdByRole       UserRole?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  store               Store                  @relation(fields: [storeId], references: [id])
  product             Product                @relation(fields: [productId], references: [id])
  transactions        InventoryTransaction[]
  invoiceItems        InvoiceItem[]
  kachaInvoiceItems   KachaInvoiceItem[]
  karigarJobs         KarigarJob[]
  vendor              Vendor?                @relation(fields: [vendorId], references: [id])
  vendorId            String?
  purchaseItems       PurchaseItem[]
  karigarReceiptItems KarigarReceiptItem[]
  quotationItems      QuotationItem[]
  metalType           StoreMetal?            @relation(fields: [metalTypeId], references: [id])
  location            StoreLocation?         @relation(fields: [locationId], references: [id])
  createdBy           User?                  @relation("InventoryStockCreatedBy", fields: [createdById], references: [id])

  @@unique([storeId, stockCode])
  @@unique([storeId, tagNumber])
  @@index([stockCode])
  @@index([tagNumber])
  @@index([productId])
  @@index([metalTypeId])
  @@index([purity])
  @@index([status])
  @@index([finish])
  @@index([purchaseDate])
  @@index([locationId])
  @@index([vendorId])
  @@index([storeId])
}

model InventoryTransaction {
  id               String                   @id @default(cuid())
  inventoryStockId String
  transactionType  InventoryTransactionType
  quantity         Int                      @default(1)
  grossWeight      Decimal?                 @db.Decimal(12, 5)
  netWeight        Decimal?                 @db.Decimal(12, 5)
  referenceType    String?
  referenceId      String?
  notes            String?
  createdAt        DateTime                 @default(now())
  inventoryStock   InventoryStock           @relation(fields: [inventoryStockId], references: [id], onDelete: Cascade)

  @@index([inventoryStockId])
  @@index([transactionType])
  @@index([referenceType, referenceId])
  @@index([createdAt])
}

model Invoice {
  id                     String         @id @default(cuid())
  storeId                String
  invoiceNumber          String
  customerId             String
  invoiceDate            DateTime       @default(now())
  dueDate                DateTime?
  status                 InvoiceStatus  @default(PAID)
  subtotal               Decimal        @default(0) @db.Decimal(12, 2)
  makingCharges          Decimal        @default(0) @db.Decimal(12, 2)
  stoneCharges           Decimal        @default(0) @db.Decimal(12, 2)
  discount               Decimal        @default(0) @db.Decimal(12, 2)
  taxAmount              Decimal        @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal        @default(0) @db.Decimal(12, 2)
  paidAmount             Decimal        @default(0) @db.Decimal(12, 2)
  balanceAmount          Decimal        @default(0) @db.Decimal(12, 2)
  notes                  String?
  // Who raised it. The id is the link; the name is a snapshot, because staff
  // leave and get renamed and an invoice has to keep saying who sold it.
  // Nullable: invoices raised before this was recorded genuinely have no
  // answer, and inventing one would be worse than showing none.
  createdById            String?
  createdByName          String?
  // Set when this invoice is cancelled via cancelInvoice — the id/name
  // snapshot follows the same convention as createdById/createdByName,
  // for the same reason (staff leave and get renamed).
  cancelledAt            DateTime?
  cancelledById          String?
  cancelledByName        String?
  cancellationReason     String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  store                  Store          @relation(fields: [storeId], references: [id])
  createdBy              User?          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  cancelledBy            User?          @relation("InvoiceCancelledBy", fields: [cancelledById], references: [id])
  customer               Customer       @relation(fields: [customerId], references: [id])
  items                  InvoiceItem[]
  ledgerEntries          LedgerEntry[]
  convertedFromKacha     KachaInvoice?  @relation("KachaConvertedToPakka")
  convertedFromQuotation Quotation?     @relation("QuotationConvertedToInvoice")
  locationId             String?
  location               StoreLocation? @relation(fields: [locationId], references: [id])
  // Self-relation for "this invoice was raised to replace a cancelled
  // one" — replacesId lives on the new invoice (same source-owns-the-FK
  // convention as KachaInvoice.convertedToId/Quotation.convertedToId
  // pointing at Invoice), @unique so a cancelled invoice can be replaced
  // by at most one new invoice.
  replacesId             String?        @unique
  replaces               Invoice?       @relation("InvoiceReplaces", fields: [replacesId], references: [id])
  replacedBy             Invoice?       @relation("InvoiceReplaces")

  @@unique([storeId, invoiceNumber])
  @@index([createdById])
  @@index([cancelledById])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([invoiceNumber])
  @@index([storeId])
  @@index([locationId])
}

model KachaInvoice {
  id            String             @id @default(cuid())
  storeId       String
  slipNumber    String
  customerId    String
  invoiceDate   DateTime           @default(now())
  status        InvoiceStatus      @default(PAID)
  subtotal      Decimal            @default(0) @db.Decimal(12, 2)
  makingCharges Decimal            @default(0) @db.Decimal(12, 2)
  stoneCharges  Decimal            @default(0) @db.Decimal(12, 2)
  discount      Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount   Decimal            @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal            @default(0) @db.Decimal(12, 2)
  balanceAmount Decimal            @default(0) @db.Decimal(12, 2)
  notes         String?
  convertedToId String?            @unique
  convertedTo   Invoice?           @relation("KachaConvertedToPakka", fields: [convertedToId], references: [id])
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  store         Store              @relation(fields: [storeId], references: [id])
  customer      Customer           @relation(fields: [customerId], references: [id])
  items         KachaInvoiceItem[]
  locationId    String?
  location      StoreLocation?     @relation(fields: [locationId], references: [id])

  @@unique([storeId, slipNumber])
  @@index([customerId])
  @@index([invoiceDate])
  @@index([status])
  @@index([slipNumber])
  @@index([storeId])
  @@index([locationId])
}

model KachaInvoiceItem {
  id                 String          @id @default(cuid())
  kachaInvoiceId     String
  itemName           String
  metalTypeId        String?
  purity             PurityType?
  quantity           Int             @default(1)
  grossWeight        Decimal?        @db.Decimal(12, 5)
  netWeight          Decimal?        @db.Decimal(12, 5)
  dmoWeight          Decimal?        @db.Decimal(12, 5)
  stoneWeight        Decimal?        @db.Decimal(12, 5)
  caratWeight        Decimal?        @db.Decimal(10, 3)
  rate               Decimal?        @db.Decimal(12, 2)
  makingCharge       Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType   ChargeType      @default(FIXED)
  stoneCharge        Decimal         @default(0) @db.Decimal(12, 2)
  stoneRate          Decimal?        @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName String?
  stoneTypeNames     String?
  lineTotal          Decimal         @default(0) @db.Decimal(12, 2)
  inventoryStockId   String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryStock     InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  kachaInvoice       KachaInvoice    @relation(fields: [kachaInvoiceId], references: [id], onDelete: Cascade)
  metalType          StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([kachaInvoiceId])
  @@index([inventoryStockId])
}

model InvoiceItem {
  id                 String          @id @default(cuid())
  invoiceId          String
  itemName           String
  metalTypeId        String?
  quantity           Int             @default(1)
  grossWeight        Decimal?        @db.Decimal(12, 5)
  netWeight          Decimal?        @db.Decimal(12, 5)
  dmoWeight          Decimal?        @db.Decimal(12, 5)
  // Net stone weight (carats or grams, store's choice — same free-typed
  // convention as every other weight field), separate from dmoWeight (which
  // is Dust/Making/Other, not stone).
  stoneWeight        Decimal?        @db.Decimal(12, 5)
  // Diamond weight in carats, only meaningful when purity is DIAMOND — a
  // dedicated, unambiguous unit (unlike stoneWeight above), since rate then
  // prices per carat rather than per gram.
  caratWeight        Decimal?        @db.Decimal(10, 3)
  rate               Decimal?        @db.Decimal(12, 2)
  makingCharge       Decimal         @default(0) @db.Decimal(12, 2)
  makingChargeType   ChargeType      @default(FIXED)
  // Hallmarking charge, shown as its own line under Making Charges on the
  // printed invoice — distinct from makingCharge itself.
  hmCharge           Decimal         @default(0) @db.Decimal(12, 2)
  stoneCharge        Decimal         @default(0) @db.Decimal(12, 2)
  stoneRate          Decimal?        @db.Decimal(12, 2)
  // Denormalized names, not FKs — see Product.defaultStoneMetalTypeName's
  // doc comment for why.
  stoneMetalTypeName String?
  stoneTypeNames     String?
  // Per-line scheme/discount amount, separate from Invoice.discount (which
  // is an invoice-level total) — the printed format wants one column per
  // line, not a single amount split across items after the fact.
  schemeDiscount     Decimal         @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  cgstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  // Charged instead of sgstAmount+cgstAmount when the sale is inter-state
  // (customer's state differs from the store's own) - never both at once,
  // see computeGst() in lib/gst.ts. Always 0 for a Composition-scheme store,
  // same as sgst/cgst - a composition dealer never itemizes GST at all.
  igstAmount         Decimal         @default(0) @db.Decimal(12, 2)
  // HSN snapshot at sale time — Product.hsnCode can change later, and a
  // manually-entered line (no linked stock/product) has no HSN otherwise.
  hsnCode            String?
  lineTotal          Decimal         @default(0) @db.Decimal(12, 2)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryStockId   String?
  purity             PurityType?
  inventoryStock     InventoryStock? @relation(fields: [inventoryStockId], references: [id])
  invoice            Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  metalType          StoreMetal?     @relation(fields: [metalTypeId], references: [id])

  @@index([invoiceId])
  @@index([inventoryStockId])
}

model LedgerEntry {
  id               String           @id @default(cuid())
  storeId          String
  entryDate        DateTime         @default(now())
  type             LedgerEntryType
  sourceType       LedgerSourceType @default(MANUAL)
  customerId       String?
  karigarId        String?
  invoiceId        String?
  purchaseId       String?
  vendorId         String?
  metalTypeId      String?
  metalWeight      Decimal?         @db.Decimal(12, 5)
  metalWeightFine  Decimal?         @db.Decimal(12, 5)
  // Diamond entries are carat-based, not weight-based — metalWeight/
  // metalWeightFine stay null for them (same 12,5 columns other metals use
  // in grams would be the wrong unit). Matches the caratWeight precision
  // already used on PurchaseItem/InvoiceItem/KachaInvoiceItem/QuotationItem/
  // Product/InventoryStock (see the 20260901193000 migration).
  caratWeight      Decimal?         @db.Decimal(10, 3)
  amount           Decimal          @default(0) @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?
  paymentReference String?
  bankName         String?
  attachmentUrl    String?
  description      String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  store            Store            @relation(fields: [storeId], references: [id])
  customer         Customer?        @relation(fields: [customerId], references: [id])
  invoice          Invoice?         @relation(fields: [invoiceId], references: [id])
  karigar          Karigar?         @relation(fields: [karigarId], references: [id])
  purchase         Purchase?        @relation(fields: [purchaseId], references: [id])
  vendor           Vendor?          @relation(fields: [vendorId], references: [id])
  metalType        StoreMetal?      @relation(fields: [metalTypeId], references: [id])
  locationId       String?
  location         StoreLocation?   @relation(fields: [locationId], references: [id])

  @@index([entryDate])
  @@index([customerId])
  @@index([karigarId])
  @@index([invoiceId])
  @@index([purchaseId])
  @@index([vendorId])
  @@index([type])
  @@index([sourceType])
  @@index([storeId])
  @@index([locationId])
}

model KarigarJob {
  id                String               @id @default(cuid())
  storeId           String
  jobNumber         String?
  karigarId         String
  issueDate         DateTime             @default(now())
  expectedDate      DateTime?
  receivedDate      DateTime?
  metalTypeId       String?
  issueWeight       Decimal?             @db.Decimal(12, 5)
  issuePurity       PurityType?
  issueFineWeight   Decimal?             @db.Decimal(12, 5)
  receiveWeight     Decimal?             @db.Decimal(12, 5)
  receiveFineWeight Decimal?             @db.Decimal(12, 5)

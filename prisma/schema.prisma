enum ChargeType {
  FIXED
  PERCENTAGE
}

// Who a design is made for — the one piece of a Product's SKU (see
// Product.productCode's own doc comment) with no other home in the schema:
// Category/Type already names the item shape (Ring, Chain, ...), Metal/
// Purity already name the material, but nothing previously captured
// "Ladies" vs "Gents" vs "Kids" vs "Unisex" — a real, independent axis a
// store designs against (the same Ring category spans all four).
enum TargetStyle {
  LADIES
  GENTS
  KIDS
  UNISEX
}

// Which structured layout createProduct's SKU generator uses — a
// store-picked preset (Settings > Business Settings > SKU Format), not a
// free-form template. See lib/inventory/product-sku.ts's composeSkuPrefix()
// for exactly what each arranges; e.g. METAL_PURITY_STYLE_CATEGORY produces
// "G22-LR-001", METAL_CATEGORY_PURITY produces "GR22-001". Changing this
// only affects products created AFTER the change — existing productCode
// values are never rewritten, same as every other productCode convention.
enum SkuFormat {
  METAL_PURITY_STYLE_CATEGORY
  METAL_CATEGORY_PURITY
  CATEGORY_METAL_PURITY
  STYLE_CATEGORY_METAL_PURITY
}

// Which physical format the Invoice print page renders in — see
// app/(dashboard)/billing/[id]/print/page.tsx. A4 is the existing full
// detailed layout (logo band, GST rate-wise summary, bank details, terms);
// THERMAL is a narrow 80mm receipt-printer format (plain list, no color
// bands) for stores that bill at a counter with a receipt printer instead
// of a full-page one. Store-wide (BusinessSettings.printLayout), not
// per-invoice — matches SkuFormat's own "one store-wide choice" convention.
enum PrintLayout {
  A4
  THERMAL
}

// Which professionally-designed A4 template a store's Invoice/Kacha Slip/
// Quotation print pages render in — see BusinessSettings.invoiceTemplate.
// One store-wide choice applied consistently across all three A4 print
// pages (not per-document), same "one setting, several consumers"
// convention as PrintLayout/SkuFormat.
//   CLASSIC - the original design: a violet contact bar, a dark curved
//             identity block, a violet-header items table, a boxed totals
//             summary. Unchanged from before this enum existed.
//   MODERN  - light and airy, an indigo accent used sparingly (a thin
//             underline + the Total row only), alternating-row items table,
//             no color bands or curved shapes.
//   MINIMAL - pure black-and-white/grayscale, hairline rules only, a
//             stacked (not boxed) layout — ink-saving, formal, prints
//             cleanly on any printer.
//   ELEGANT - a gold accent (matching this app's own brand gold) and a
//             serif display font for headings, generous letter-spacing, a
//             centered header — a boutique/premium jewellery-store feel.
enum InvoiceTemplate {
  CLASSIC
  MODERN
  MINIMAL
  ELEGANT
}

// The three GST registration types a jewellery business can operate under
// in India - see BusinessSettings.gstScheme. Each has real legal
// consequences for what an invoice/quotation/purchase bill must show:
//   REGULAR_B2C  - Retailer. Full SGST+CGST (or IGST if inter-state) shown
//                  and collected from the customer. Customer GSTIN optional.
//   REGULAR_B2B  - Wholesaler & Manufacturer. Same tax collection as B2C,
//                  but selling to other GST-registered businesses, so the
//                  buyer's GSTIN is required for a valid B2B tax invoice.
//   COMPOSITION  - Small local jeweler under the Composition Scheme. Legally
//                  PROHIBITED from showing/collecting GST as a line item on
//                  any document - no SGST/CGST/IGST columns at all. Must
//                  print "Bill of Supply" (never "Tax Invoice") with the
//                  mandatory disclaimer. The dealer still pays a small flat
//                  tax to the government, but out of their own margin, never
//                  itemized to the customer, and can never claim input tax
//                  credit on purchases either.
enum GstScheme {
  REGULAR_B2C
  REGULAR_B2B
  COMPOSITION
}

// A Customer's or Vendor's OWN GST registration status - independent of
// BusinessSettings.gstScheme above, which only describes the STORE's own
// registration. B2B vs B2C is not a registration category a counterparty
// can "be" - it's simply whether they're GST-registered at all, which is
// exactly what this models:
//   UNREGISTERED - No GSTIN. GSTIN is never required/shown for this party.
//   REGULAR      - Has a GSTIN, charges/receives full GST normally. As a
//                  Vendor, their invoice to us legitimately shows GST - see
//                  gstinRequired()/isVendorGstApplicable() in lib/gst.ts.
//   COMPOSITION  - Has a GSTIN, but (same legal restriction as GstScheme's
//                  own COMPOSITION) can never itemize GST on an invoice THEY
//                  issue. Only meaningful for Vendor: a Composition vendor's
//                  purchase bill to us never carries a tax breakdown,
//                  regardless of what GstScheme our own store operates
//                  under. For a Customer this only affects GSTIN capture,
//                  same as REGULAR - we're still the ones issuing the
//                  invoice, so it's our own GstScheme, not theirs, that
//                  decides what our invoice can show.
enum PartyGstType {
  UNREGISTERED
  REGULAR
  COMPOSITION
}

enum PurityType {
  GOLD_18K
  GOLD_20K
  GOLD_22K
  GOLD_24K
  SILVER_925
  SILVER_999
  PLATINUM_900

/**
 * A counter-side scanning session.
 * Opened from the billing screen on a laptop so that tags scanned with a
 * phone land on that invoice. It exists in the database rather than in
 * memory because the two devices talk through separate serverless requests
 * and share nothing else.
 */
model ScanSession {
  id        String            @id @default(cuid())
  storeId   String
  userId    String
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  // Sessions are abandoned far more often than they are closed — a browser
  // tab just goes away. An expiry means an old one cannot silently swallow
  // a scan days later.
  expiresAt DateTime
  store     Store             @relation(fields: [storeId], references: [id])
  user      User              @relation(fields: [userId], references: [id])
  items     ScanSessionItem[]

  @@index([userId, isActive])
  @@index([storeId])
}

model ScanSessionItem {
  id        String      @id @default(cuid())
  sessionId String
  stockId   String
  createdAt DateTime    @default(now())
  session   ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

/**
 * One row per (store, super admin) who has successfully redeemed that
 * store's Collaboration Code — see Store.collaborationCode's own doc
 * comment for the full mechanism. `grantedCodeVersion` snapshots
 * Store.collaborationCodeVersion at the moment of redemption; access is
 * live only while it still equals the store's CURRENT version — checked in
 * lib/store-membership.ts's listCollaborationGrants, the only reader of
 * this comparison. Regenerating the code bumps the version, which silently
 * retires every row redeemed under the old one — rows are never deleted on
 * regeneration, so this doubles as a redemption history (who has ever had
 * access to this store, and when).
 */
model StoreCollaborationAccess {
  id                 String   @id @default(cuid())
  storeId            String
  superAdminUserId   String
  grantedCodeVersion Int
  grantedAt          DateTime @default(now())
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  superAdminUser     User     @relation(fields: [superAdminUserId], references: [id], onDelete: Cascade)

  @@unique([storeId, superAdminUserId])
  @@index([storeId])
  @@index([superAdminUserId])
}

/**
 * The reverse direction of Store Owner Authorization: instead of the owner
 * generating a Collaboration Code and sharing it out-of-band, a Super Admin
 * can ask for access directly from the Platform Stores console, and the
 * owner approves or denies it from Settings > Collaboration — no code
 * changes hands on this path at all. Approving one upserts a
 * StoreCollaborationAccess row the exact same way redeeming a code does
 * (grantedCodeVersion snapshotted from the store's CURRENT
 * collaborationCodeVersion), so access granted this way is revoked by the
 * owner regenerating their code, same as any other grant — there is only
 * ever one access-revocation mechanism, regardless of which path created
 * the grant.
 * At most one row may be PENDING per (storeId, superAdminUserId) at a time
 * — enforced in requestStoreAccess, not a DB constraint, since a denied or
 * approved request must stay in history rather than block a future
 * re-request.
 */
model StoreAccessRequest {
  id                String    @id @default(cuid())
  storeId           String
  superAdminUserId  String
  status            String    @default("PENDING")
  message           String?
  requestedAt       DateTime  @default(now())
  respondedAt       DateTime?
  respondedByUserId String?
  store             Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  superAdminUser    User      @relation("StoreAccessRequestedBy", fields: [superAdminUserId], references: [id], onDelete: Cascade)
  respondedBy       User?     @relation("StoreAccessRequestRespondedBy", fields: [respondedByUserId], references: [id])

  @@index([storeId, status])
  @@index([superAdminUserId])
}
